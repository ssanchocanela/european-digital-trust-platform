@@ -0,0 +1,28 @@
+package eu.europa.ec.eudi.etsi119602.consultation.edtp
+
+import eu.europa.ec.eudi.etsi119602.consultation.MDL_USE_CASE
+import eu.europa.ec.eudi.etsi119602.consultation.eu
+import eu.europa.ec.eudi.etsi119602.consultation.eu.EUMDLProvidersListSpec
+import eu.europa.ec.eudi.etsi119602.datamodel.Uri
+import eu.europa.ec.eudi.etsi1196x2.consultation.SupportedLists
+import eu.europa.ec.eudi.etsi1196x2.consultation.VerificationContext
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertNotNull
+
+// EDTP WD-12: the EU baseline carries the mDL Providers list under "mdl".
+class EdtpWd12Test {
+
+    @Test
+    fun `the EU baseline maps the mDL issuance and revocation service types`() {
+        val mdl = assertNotNull(SupportedLists.eu().eaaProviders[MDL_USE_CASE])
+        assertEquals(
+            Uri.parse(EUMDLProvidersListSpec.SVC_TYPE_ISSUANCE),
+            mdl.svcTypePerCtx.getValue(VerificationContext.EAA(MDL_USE_CASE)).svcTypeIdentifier,
+        )
+        assertEquals(
+            Uri.parse(EUMDLProvidersListSpec.SVC_TYPE_REVOCATION),
+            mdl.svcTypePerCtx.getValue(VerificationContext.EAAStatus(MDL_USE_CASE)).svcTypeIdentifier,
+        )
+    }
+}
