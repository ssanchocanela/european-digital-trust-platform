+ *
+ * EDTP addition. Not part of the upstream EUDI Reference Implementation.
+ */
+
+package eu.europa.ec.readerfeature.ui.scan
+
+import android.Manifest
+import android.os.Build
+import androidx.camera.core.CameraSelector
+import androidx.camera.core.ImageAnalysis
+import androidx.camera.core.Preview
+import androidx.camera.lifecycle.ProcessCameraProvider
+import androidx.camera.view.PreviewView
+import androidx.compose.foundation.background
+import androidx.compose.foundation.layout.Arrangement
+import androidx.compose.foundation.layout.Box
+import androidx.compose.foundation.layout.Column
+import androidx.compose.foundation.layout.Row
+import androidx.compose.foundation.layout.fillMaxSize
+import androidx.compose.foundation.layout.fillMaxWidth
+import androidx.compose.foundation.layout.padding
+import androidx.compose.foundation.rememberScrollState
+import androidx.compose.foundation.verticalScroll
+import androidx.compose.material3.Button
+import androidx.compose.material3.HorizontalDivider
+import androidx.compose.material3.MaterialTheme
+import androidx.compose.material3.Text
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.remember
+import androidx.compose.ui.Alignment
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.graphics.Color
+import androidx.compose.ui.platform.LocalContext
+import androidx.compose.ui.text.style.TextAlign
+import androidx.compose.ui.unit.dp
+import androidx.compose.ui.viewinterop.AndroidView
+import androidx.core.content.ContextCompat
+import androidx.lifecycle.compose.LocalLifecycleOwner
+import androidx.lifecycle.compose.collectAsStateWithLifecycle
+import androidx.navigation.NavController
+import com.google.accompanist.permissions.ExperimentalPermissionsApi
+import com.google.accompanist.permissions.rememberMultiplePermissionsState
+import eu.europa.ec.commonfeature.ui.qr_scan.component.QrCodeAnalyzer
+import eu.europa.ec.readerfeature.interactor.CheckOutcome
+import eu.europa.ec.readerfeature.interactor.ReaderCheck
+import eu.europa.ec.readerfeature.interactor.ReaderDocument
+import eu.europa.ec.uilogic.component.content.ContentScreen
+import eu.europa.ec.uilogic.component.content.ContentTitle
+import eu.europa.ec.uilogic.component.content.ScreenNavigateAction
+import eu.europa.ec.uilogic.component.utils.OncePerViewModelEffect
+import eu.europa.ec.uilogic.component.utils.SPACING_MEDIUM
+import eu.europa.ec.uilogic.component.utils.SPACING_SMALL
+import kotlinx.coroutines.flow.collect
+import kotlinx.coroutines.flow.onEach
+import java.util.concurrent.Executors
+
+private val readerPermissions: List<String>
+    get() = buildList {
+        add(Manifest.permission.CAMERA)
+        // Runtime BLE permissions exist from Android 12 (API 31); below that the install-time
+        // BLUETOOTH/BLUETOOTH_ADMIN permissions cover it and no runtime grant is needed.
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {
+            add(Manifest.permission.BLUETOOTH_SCAN)
+            add(Manifest.permission.BLUETOOTH_CONNECT)
+            add(Manifest.permission.BLUETOOTH_ADVERTISE)
+        }
+    }
+
+/**
+ * Reader (verifier) entry screen.
+ *
+ * Phase 2: request camera + BLE permissions, scan the holder's device-engagement QR, hand it to the
+ * view model, and reflect the transport state (scanning → connecting → connected). The disclosed
+ * attributes and the verification verdict replace the connected state in later phases.
+ */
+@OptIn(ExperimentalPermissionsApi::class)
+@Composable
+fun ReaderScanScreen(
+    navController: NavController,
+    viewModel: ReaderScanViewModel,
+) {
+    val state: State by viewModel.viewState.collectAsStateWithLifecycle()
+    val context = LocalContext.current
+    val permissions = rememberMultiplePermissionsState(readerPermissions)
+
+    ContentScreen(
+        isLoading = state.isLoading,
+        navigatableAction = ScreenNavigateAction.BACKABLE,
+        onBack = { viewModel.setEvent(Event.GoBack) },
+    ) { paddingValues ->
+        Column(
+            modifier = Modifier
+                .fillMaxSize()
+                .padding(paddingValues),
+            verticalArrangement = Arrangement.spacedBy(SPACING_MEDIUM.dp),
+        ) {
+            ContentTitle(
+                title = "Read in person (verifier)",
+                subtitle = when (state.status) {
+                    ReaderStatus.SCANNING -> "Point the camera at the holder's QR code."
+                    ReaderStatus.CONNECTING -> "Connecting over Bluetooth…"
+                    ReaderStatus.CONNECTED -> "Connected. Requesting the credential…"
+                    ReaderStatus.REQUESTING -> "Reading the credential…"
+                    ReaderStatus.COMPLETED -> "Credential read. Verification verdict comes next."
+                    ReaderStatus.DISCONNECTED -> "The other device disconnected."
+                    ReaderStatus.ERROR -> state.error ?: "Something went wrong."
+                },
+            )
+
+            when {
+                !permissions.allPermissionsGranted -> PermissionPrompt { permissions.launchMultiplePermissionRequest() }
+
+                state.status == ReaderStatus.SCANNING -> CameraPreview(
+                    onQrScanned = { payload -> viewModel.setEvent(Event.QrScanned(context, payload)) },
+                )
+
+                state.status == ReaderStatus.COMPLETED -> AttributesList(
+                    documents = state.documents,
+                    onReadAgain = { viewModel.setEvent(Event.Retry) },
+                )
+
+                else -> StatusPanel(
+                    status = state.status,
+                    error = state.error,
+                    onRetry = { viewModel.setEvent(Event.Retry) },
+                )
+            }
+        }
+    }
+
+    OncePerViewModelEffect(viewModel) {
+        viewModel.setEvent(Event.Init)
+    }
+
+    androidx.compose.runtime.LaunchedEffect(Unit) {
+        viewModel.effect.onEach { effect ->
+            when (effect) {
+                is Effect.Navigation.Pop -> navController.popBackStack()
+            }
+        }.collect()
+    }
+}
+
+@Composable
+private fun PermissionPrompt(onRequest: () -> Unit) {
+    Column(
+        modifier = Modifier.fillMaxWidth(),
+        verticalArrangement = Arrangement.spacedBy(SPACING_MEDIUM.dp),
+        horizontalAlignment = Alignment.CenterHorizontally,
+    ) {
+        Text(
+            text = "Reading in person needs the camera (to scan the QR) and Bluetooth (to connect).",
+            style = MaterialTheme.typography.bodyMedium,
+            textAlign = TextAlign.Center,
+        )
+        Button(onClick = onRequest) { Text("Grant permissions") }
+    }
+}
+
+@Composable
+private fun StatusPanel(
+    status: ReaderStatus,
+    error: String?,
+    onRetry: () -> Unit,
+) {
+    Column(
+        modifier = Modifier.fillMaxWidth(),
+        verticalArrangement = Arrangement.spacedBy(SPACING_MEDIUM.dp),
+        horizontalAlignment = Alignment.CenterHorizontally,
+    ) {
+        Text(
+            text = when (status) {
+                ReaderStatus.CONNECTING -> "Connecting…"
+                ReaderStatus.CONNECTED -> "Connected"
+                ReaderStatus.REQUESTING -> "Reading…"
+                ReaderStatus.COMPLETED -> "Done"
+                ReaderStatus.DISCONNECTED -> "Disconnected"
+                ReaderStatus.ERROR -> error ?: "Error"
+                ReaderStatus.SCANNING -> ""
+            },
+            style = MaterialTheme.typography.titleMedium,
+            textAlign = TextAlign.Center,
+        )
+        if (status == ReaderStatus.ERROR || status == ReaderStatus.DISCONNECTED) {
+            Button(onClick = onRetry) { Text("Scan again") }
+        }
+    }
+}
+
+@Composable
+private fun AttributesList(
+    documents: List<ReaderDocument>,
+    onReadAgain: () -> Unit,
+) {
+    Column(
+        modifier = Modifier
+            .fillMaxWidth()
+            .verticalScroll(rememberScrollState()),
+        verticalArrangement = Arrangement.spacedBy(SPACING_MEDIUM.dp),
+    ) {
+        if (documents.isEmpty()) {
+            Text(
+                text = "The holder disclosed no attributes.",
+                style = MaterialTheme.typography.bodyMedium,
+            )
+        }
+        documents.forEach { document ->
+            Text(
+                text = document.docType,
+                style = MaterialTheme.typography.titleSmall,
+            )
+
+            Text(
+                text = "Verification",
+                style = MaterialTheme.typography.labelLarge,
+            )
+            document.checks.forEach { check ->
+                CheckRow(check)
+            }
+
+            Text(
+                text = "Disclosed attributes",
+                style = MaterialTheme.typography.labelLarge,
+            )
+            document.attributes.forEach { attribute ->
+                Column(modifier = Modifier.fillMaxWidth()) {
+                    Text(
+                        text = attribute.element,
+                        style = MaterialTheme.typography.labelMedium,
+                    )
+                    Text(
+                        text = attribute.value,
+                        style = MaterialTheme.typography.bodyMedium,
+                    )
+                }
+            }
+            HorizontalDivider()
+        }
+        Button(onClick = onReadAgain) { Text("Read another") }
+    }
+}
+
+@Composable
+private fun CheckRow(check: ReaderCheck) {
+    val (glyph, color) = when (check.outcome) {
+        CheckOutcome.PASS -> "✓" to Color(0xFF2E7D32)
+        CheckOutcome.FAIL -> "✗" to MaterialTheme.colorScheme.error
+        CheckOutcome.SKIPPED -> "–" to MaterialTheme.colorScheme.onSurfaceVariant
+    }
+    Row(
+        modifier = Modifier.fillMaxWidth(),
+        horizontalArrangement = Arrangement.spacedBy(SPACING_SMALL.dp),
+    ) {
+        Text(text = glyph, color = color, style = MaterialTheme.typography.bodyMedium)
+        Column(modifier = Modifier.fillMaxWidth()) {
+            Text(text = check.name, style = MaterialTheme.typography.bodyMedium)
+            check.detail?.let {
+                Text(
+                    text = it,
+                    color = MaterialTheme.colorScheme.onSurfaceVariant,
+                    style = MaterialTheme.typography.bodySmall,
+                )
+            }
+        }
+    }
+}
+
+@Composable
+private fun CameraPreview(
+    onQrScanned: (String) -> Unit,
+) {
+    val context = LocalContext.current
+    val lifecycleOwner = LocalLifecycleOwner.current
+    val analysisExecutor = remember { Executors.newSingleThreadExecutor() }
+
+    Box(
+        modifier = Modifier
+            .fillMaxSize()
+            .background(Color.Black),
+        contentAlignment = Alignment.Center,
+    ) {
+        AndroidView(
+            modifier = Modifier.fillMaxSize(),
+            factory = { ctx ->
+                val previewView = PreviewView(ctx)
+                val preview = Preview.Builder().build()
+                val selector = CameraSelector.Builder()
+                    .requireLensFacing(CameraSelector.LENS_FACING_BACK)
+                    .build()
+                preview.surfaceProvider = previewView.surfaceProvider
+
+                val imageAnalysis = ImageAnalysis.Builder()
+                    .setBackpressureStrategy(ImageAnalysis.STRATEGY_KEEP_ONLY_LATEST)
+                    .build()
+                imageAnalysis.setAnalyzer(
+                    analysisExecutor,
+                    QrCodeAnalyzer { result ->
+                        ContextCompat.getMainExecutor(ctx).execute { onQrScanned(result) }
+                    },
+                )
+
+                runCatching {
+                    ProcessCameraProvider.getInstance(ctx).get().bindToLifecycle(
+                        lifecycleOwner,
+                        selector,
+                        preview,
+                        imageAnalysis,
+                    )
+                }
+                previewView
+            },
+        )
+    }
+}
