diff --git a/network-logic/src/test/java/eu/europa/ec/networklogic/di/EdtpSignedMetadataAcceptTest.kt b/network-logic/src/test/java/eu/europa/ec/networklogic/di/EdtpSignedMetadataAcceptTest.kt
new file mode 100644
index 0000000..5b2c93d
--- /dev/null
+++ b/network-logic/src/test/java/eu/europa/ec/networklogic/di/EdtpSignedMetadataAcceptTest.kt
@@ -0,0 +1,38 @@
+/*
+ * EDTP deviation WD-11. Not upstream.
+ */
+
+package eu.europa.ec.networklogic.di
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNull
+import org.junit.Test
+
+class EdtpSignedMetadataAcceptTest {
+
+    private val metadata = "/.well-known/openid-credential-issuer/issuer"
+
+    @Test
+    fun `a metadata request for signed metadata asks for nothing else`() {
+        assertEquals("application/jwt", signedMetadataAccept(metadata, listOf("application/jwt", "application/json")))
+        assertEquals("application/jwt", signedMetadataAccept(metadata, listOf("application/jwt, application/json")))
+        assertEquals("application/jwt", signedMetadataAccept(metadata, listOf("application/jwt;q=1", "*/*")))
+    }
+
+    @Test
+    fun `a metadata request that already asks for it alone is left as it is`() {
+        assertNull(signedMetadataAccept(metadata, listOf("application/jwt")))
+    }
+
+    @Test
+    fun `a metadata request that does not ask for signed metadata is left as it is`() {
+        assertNull(signedMetadataAccept(metadata, listOf("application/json")))
+        assertNull(signedMetadataAccept(metadata, emptyList()))
+    }
+
+    @Test
+    fun `no other request is touched`() {
+        assertNull(signedMetadataAccept("/issuer/credential-offer", listOf("application/jwt", "application/json")))
+        assertNull(signedMetadataAccept("/.well-known/oauth-authorization-server/pre-auth", listOf("application/jwt", "application/json")))
+    }
+}
