--- /dev/null
+++ b/business-logic/src/main/java/eu/europa/ec/edtp/trust/TrustModel.kt
@@ -0,0 +1,86 @@
+/*
+ * Copyright (c) 2026 European Commission
+ *
+ * Licensed under the EUPL, Version 1.2 or - as soon they will be approved by the European
+ * Commission - subsequent versions of the EUPL (the "Licence"); You may not use this work
+ * except in compliance with the Licence.
+ *
+ * You may obtain a copy of the Licence at:
+ * https://joinup.ec.europa.eu/software/page/eupl
+ *
+ * Unless required by applicable law or agreed to in writing, software distributed under
+ * the Licence is distributed on an "AS IS" basis, WITHOUT WARRANTIES OR CONDITIONS OF
+ * ANY KIND, either express or implied. See the Licence for the specific language
+ * governing permissions and limitations under the Licence.
+ *
+ * ---
+ *
+ * EDTP addition. Not part of the upstream EUDI Reference Implementation.
+ */
+
+package eu.europa.ec.edtp.trust
+
+/** The three independent validation layers the wallet can run. */
+enum class TrustLayer { C1_SIGNATURES, C2_CHAIN, C3_REVOCATION }
+
+/** Per-layer mode. OFF = do not run (upstream behaviour); OBSERVE = run + record, never block;
+ *  ENFORCE = run + record, and block the flow on a failed/unknown result. */
+enum class TrustMode { OFF, OBSERVE, ENFORCE }
+
+/** Where in the lifecycle a check ran. */
+enum class TrustPoint { OFFER, PRESTORE, PRESENT }
+
+/** What the check was about. Kept coarse on purpose — the detail string carries specifics. */
+enum class TrustSubject {
+    ISSUER_SIGNATURE,       // mdoc MSO / SD-JWT VC issuer signature
+    DOC_SIGNER_CHAIN,       // issuer document-signer certificate chain vs LoTE anchors
+    CREDENTIAL_STATUS,      // the issued credential's own status list
+    REQUEST_OBJECT_SIG,     // OpenID4VP request object signature / ISO reader auth
+    RPAC,                   // relying-party / reader access certificate (chain, validity, revocation)
+    RPRC,                   // relying-party / issuer registration certificate (WRPRC)
+    HOLDER_BINDING,         // cnf / device-key binding, isBoundTo(access cert)
+    ENTITLEMENT,            // issuer entitlements / over-provisioning / over-asking
+}
+
+/** Outcome of a single check. UNKNOWN is a first-class failure mode (e.g. revocation not reachable). */
+enum class TrustOutcome { PASS, FAIL, UNKNOWN, SKIP }
+
+/**
+ * Reason codes. These mirror the enums the upstream core already produces so the overlay can show
+ * the same vocabulary a developer would see in logs. Not exhaustive; [TrustCheckResult.detail]
+ * carries anything finer. OTHER is the catch-all.
+ */
+enum class TrustReason {
+    OK,
+    SIGNATURE_INVALID,
+    UNTRUSTED_PROVIDER,
+    NOT_BOUND_TO_REQUESTER,
+    EXPIRED,
+    REVOKED,
+    REVOCATION_STATUS_UNKNOWN,
+    STATUS_MISSING,
+    ENTITLEMENT_MISSING,
+    OVER_ASKING,
+    MALFORMED,
+    NOT_EVALUATED,
+    OTHER,
+}
+
+/** One recorded check. Immutable; the ledger only ever appends. */
+data class TrustCheckResult(
+    val layer: TrustLayer,
+    val point: TrustPoint,
+    val subject: TrustSubject,
+    val outcome: TrustOutcome,
+    val reason: TrustReason = if (outcome == TrustOutcome.PASS) TrustReason.OK else TrustReason.OTHER,
+    val detail: String? = null,
+    val atMillis: Long = System.currentTimeMillis(),
+) {
+    val isBlocking: Boolean get() = outcome == TrustOutcome.FAIL || outcome == TrustOutcome.UNKNOWN
+}
+
+/** Thrown by [TrustGate] when a layer in ENFORCE sees a blocking result. Callers translate it into
+ *  the point-appropriate refusal (OfferResult.Failure / delete-then-fail / deny-before-consent). */
+class TrustBlockedException(
+    val result: TrustCheckResult,
+) : Exception("EDTP trust ${result.layer} ENFORCE blocked: ${result.subject}=${result.reason}")
diff --git a/ui-logic/src/main/java/eu/europa/ec/edtp/trust/ui/EdtpTrustOverlay.kt b/ui-logic/src/main/java/eu/europa/ec/edtp/trust/ui/EdtpTrustOverlay.kt
new file mode 100644
index 0000000..c0e63c1
--- /dev/null
+++ b/ui-logic/src/main/java/eu/europa/ec/edtp/trust/ui/EdtpTrustOverlay.kt
@@ -0,0 +1,111 @@
+/*
+ * Copyright (c) 2026 European Commission
+ *
+ * Licensed under the EUPL, Version 1.2 or - as soon they will be approved by the European
+ * Commission - subsequent versions of the EUPL (the "Licence"); You may not use this work
+ * except in compliance with the Licence.
+ *
+ * You may obtain a copy of the Licence at:
+ * https://joinup.ec.europa.eu/software/page/eupl
+ *
+ * Unless required by applicable law or agreed to in writing, software distributed under
+ * the Licence is distributed on an "AS IS" basis, WITHOUT WARRANTIES OR CONDITIONS OF
+ * ANY KIND, either express or implied. See the Licence for the specific language
+ * governing permissions and limitations under the Licence.
+ *
+ * ---
+ *
+ * EDTP addition. Not part of the upstream EUDI Reference Implementation. Floating, expandable panel
+ * that shows what the granular trust layers checked in the current flow and what failed. Renders
+ * nothing unless this is an EDTP build AND at least one layer is active, so an unmodified build and a
+ * build with trust OFF are both unchanged.
+ */
+
+package eu.europa.ec.edtp.trust.ui
+
+import androidx.compose.foundation.layout.Column
+import androidx.compose.foundation.layout.Row
+import androidx.compose.foundation.layout.fillMaxWidth
+import androidx.compose.foundation.layout.padding
+import androidx.compose.foundation.lazy.LazyColumn
+import androidx.compose.foundation.lazy.items
+import androidx.compose.material3.AssistChip
+import androidx.compose.material3.Card
+import androidx.compose.material3.Text
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.remember
+import androidx.compose.runtime.setValue
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.unit.dp
+import androidx.lifecycle.compose.collectAsStateWithLifecycle
+import eu.europa.ec.edtp.trust.LayerTally
+import eu.europa.ec.edtp.trust.TrustCheckResult
+import eu.europa.ec.edtp.trust.TrustConfigHolder
+import eu.europa.ec.edtp.trust.TrustLayer
+import eu.europa.ec.edtp.trust.TrustLedger
+import eu.europa.ec.edtp.trust.TrustOutcome
+import eu.europa.ec.uilogic.BuildConfig
+
+/**
+ * Drop once in [eu.europa.ec.uilogic.component.content.ContentScreen], next to the modified-build
+ * banner, so it is present on every screen and cannot be navigated away from.
+ */
+@Composable
+fun EdtpTrustOverlay(modifier: Modifier = Modifier) {
+    if (!BuildConfig.EDTP_BUILD) return
+
+    val config by TrustConfigHolder.config.collectAsStateWithLifecycle()
+    if (!config.anyActive) return
+
+    val run by TrustLedger.current.collectAsStateWithLifecycle()
+    val current = run ?: return
+
+    var expanded by remember { mutableStateOf(false) }
+    val tallies = current.countsByLayer()
+
+    Card(modifier = modifier.fillMaxWidth().padding(8.dp)) {
+        Row(modifier = Modifier.fillMaxWidth().padding(8.dp)) {
+            TrustLayer.entries.forEach { layer ->
+                LayerBadge(layer, tallies[layer]) { expanded = !expanded }
+            }
+        }
+        if (expanded) {
+            LazyColumn(modifier = Modifier.fillMaxWidth().padding(8.dp)) {
+                items(current.results) { r -> TrustRow(r) }
+            }
+        }
+    }
+}
+
+@Composable
+private fun LayerBadge(layer: TrustLayer, tally: LayerTally?, onClick: () -> Unit) {
+    val label = buildString {
+        append(
+            when (layer) {
+                TrustLayer.C1_SIGNATURES -> "C1"
+                TrustLayer.C2_CHAIN -> "C2"
+                TrustLayer.C3_REVOCATION -> "C3"
+            }
+        )
+        if (tally != null && tally.anyRecorded) {
+            append(' ')
+            append(if (tally.anyBlocking) "✗${tally.fail + tally.unknown}" else "✓")
+        }
+    }
+    AssistChip(onClick = onClick, label = { Text(label) }, modifier = Modifier.padding(end = 6.dp))
+}
+
+@Composable
+private fun TrustRow(r: TrustCheckResult) {
+    val mark = when (r.outcome) {
+        TrustOutcome.PASS -> "✓"
+        TrustOutcome.FAIL, TrustOutcome.UNKNOWN -> "✗"
+        TrustOutcome.SKIP -> "–"
+    }
+    Column(modifier = Modifier.fillMaxWidth().padding(vertical = 2.dp)) {
+        Text("$mark  ${r.subject}  —  ${r.reason}")
+        r.detail?.let { Text("     $it") }
+    }
+}
diff --git a/ui-logic/src/main/java/eu/europa/ec/uilogic/component/content/ContentScreen.kt b/ui-logic/src/main/java/eu/europa/ec/uilogic/component/content/ContentScreen.kt
