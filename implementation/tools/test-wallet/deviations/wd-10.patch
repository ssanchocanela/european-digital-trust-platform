+package eu.europa.ec.eudi.etsi119602.datamodel
+
+import kotlinx.serialization.builtins.ListSerializer
+import kotlinx.serialization.json.Json
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertFailsWith
+
+/**
+ * EDTP deviation WD-10. Not upstream.
+ *
+ * A `LoTELegalNotice` is read whether it is written as a multilingual character string, as
+ * ETSI TS 119 602 V1.1.1 clause 6.3.11 describes it, or as the plain string this model and the JSON
+ * schema bundled with it expect.
+ */
+class EdtpLegalNoticeTest {
+    private val json = Json { ignoreUnknownKeys = true }
+
+    private fun decode(text: String): List<PolicyOrLegalNotice> =
+        json.decodeFromString(ListSerializer(PolicyOrLegalNoticeSerializer), text)
+
+    @Test
+    fun aMultilingualLegalNoticeIsRead() {
+        val read = decode("""[{"LoTELegalNotice": {"value": "Synthetic LoTE for local testing only.", "lang": "en"}}]""")
+        assertEquals(
+            listOf<PolicyOrLegalNotice>(PolicyOrLegalNotice.LegalNotice("Synthetic LoTE for local testing only.")),
+            read,
+        )
+    }
+
+    @Test
+    fun aPlainLegalNoticeIsStillRead() {
+        val read = decode("""[{"LoTELegalNotice": "A notice"}]""")
+        assertEquals(listOf<PolicyOrLegalNotice>(PolicyOrLegalNotice.LegalNotice("A notice")), read)
+    }
+
+    @Test
+    fun aPolicyIsReadAsBefore() {
+        val read = decode("""[{"LoTEPolicy": {"lang": "en", "uriValue": "https://example.test/policy"}}]""")
+        assertEquals(1, read.size)
+        assertEquals(true, read.single() is PolicyOrLegalNotice.Policy)
+    }
+
+    @Test
+    fun aLegalNoticeThatIsNeitherIsRefused() {
+        assertFailsWith<Exception> { decode("""[{"LoTELegalNotice": {"lang": "en"}}]""") }
+        assertFailsWith<Exception> { decode("""[{"LoTELegalNotice": 7}]""") }
+        assertFailsWith<Exception> { decode("""[{"LoTELegalNotice": ["a"]}]""") }
+    }
+}
