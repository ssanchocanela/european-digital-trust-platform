# The sandbox VM's .env (ADR 0017), in ~/edtp/implementation/.env on the VM, mode 600. Every secret is
# generated ON THE VM (ADR 0010 §3.3, carried over), never on a laptop and never committed:
#
#   infra/sandbox-vm/generate-secrets.sh >> .env      # once, on the VM
#
# Then fill the rest by hand, in the order of infra/sandbox-vm/README.md.

# --- the image, set by deploy.sh -------------------------------------------------------------------
EDTP_IMAGE=ghcr.io/ssanchocanela/edtp-platform:<12-hex tag>

# --- public addresses ------------------------------------------------------------------------------
ENGINE_PUBLIC_URL=https://sandbox-engine.murcata.es
PLATFORM_PUBLIC_URL=https://sandbox-platform.murcata.es
SANDBOX_PORTAL_PUBLIC_URL=https://sandbox.murcata.es
SANDBOX_PUBLIC_BASE_URL=https://sandbox-platform.murcata.es/sandbox/public
SANDBOX_VERIFIER_DNS_NAME=sandbox-engine.murcata.es
# The sandbox PID list, which participants' PID Providers are placed on. The sign-in policy must NOT
# name it (ADR 0015 Decision 2); the platform refuses to start if it does.
SANDBOX_PARTICIPANT_TRUST_SOURCES=https://sandbox-platform.murcata.es/sandbox/public/lote/PIDProviders.jwt

# --- the engine ------------------------------------------------------------------------------------
# The engine's root client id. Not a secret; create-engine-tenant.sh reads it.
ENGINE_CLIENT_ID=root
# true for the first start only; then false (docker-compose.yml, "Engine schema lifecycle").
ENGINE_DB_SYNCHRONIZE=true
# The operator's sign-in instance, from scripts/create-engine-tenant.sh sbx-operator (README step 8).
ENGINE_TENANT_CREDENTIALS=
# The EDTP TEST PID list on the operator's tenant, for sign-in (README step 8).
ENGINE_ISSUER_TRUST_LISTS=
# The Wallet Provider list id hosted issuers load (wallet-provider-anchors/ in the PKI directory).
# Defaults to sbx-wallet-providers.
# ENGINE_WALLET_PROVIDER_TRUST_LIST_ID=sbx-wallet-providers

# --- the sandbox operator, from scripts/register-sandbox-operator.mjs (README step 8) ---------------
SANDBOX_OPERATOR_TENANT_ID=
SANDBOX_SIGN_IN_POLICY_ID=

# --- secrets: generate-secrets.sh appends these ------------------------------------------------------
# PLATFORM_DB_PASSWORD=  ENGINE_DB_PASSWORD=  ENGINE_MASTER_SECRET=  ENGINE_CLIENT_SECRET=
# ENGINE_CREDENTIALS_KEY=  PLATFORM_ADMIN_API_KEY=  PSEUDONYM_MASTER_KEY=  SANDBOX_PORTAL_SECRET=
# SANDBOX_KEYSTORE_KEY=
# SANDBOX_KEYSTORE_KEY seals the CA keys. Keep a copy OUTSIDE the VM as well (the operator's password
# manager): the nightly backup holds the sealed store, and without this key it opens nothing.
