# ~/.av/demos.env on the demonstration VM, mode 600. Never committed. Generated by setup-pki.sh,
# except AV_IMAGE_TAG, which deploy.sh sets.
AV_IMAGE_TAG=
AV_PKI_PASSWORD=
# The demos' API keys, and their SHA-256 for the verifier's tenants.
LUMEN_VERIFIER_API_KEY=
PLAZA_VERIFIER_API_KEY=
AV_LUMEN_DEMO_API_KEY_SHA256=
AV_PLAZA_DEMO_API_KEY_SHA256=
LUMEN_SESSION_SECRET=
PLAZA_SESSION_SECRET=
