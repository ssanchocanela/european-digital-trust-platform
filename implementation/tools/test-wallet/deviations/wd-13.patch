+package eu.europa.ec.eudi.etsi1196x2.consultation.edtp
+
+import eu.europa.ec.eudi.etsi1196x2.consultation.CertificationChainValidation
+import eu.europa.ec.eudi.etsi1196x2.consultation.JvmSecurity
+import eu.europa.ec.eudi.etsi1196x2.consultation.NonEmptyList
+import eu.europa.ec.eudi.etsi1196x2.consultation.Sample
+import eu.europa.ec.eudi.etsi1196x2.consultation.ValidateCertificateChainUsingPKIXJvm
+import kotlinx.coroutines.test.runTest
+import java.security.cert.TrustAnchor
+import java.security.cert.X509Certificate
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertIs
+
+// EDTP WD-13: a chain that runs past a CA the trust list anchors is validated up to that CA. The
+// JDK's default provider, which is what the wallet uses.
+class EdtpWd13Test {
+    private val certs = Sample.create()
+    private val other = Sample.create() // the same names, other keys
+
+    private suspend fun validate(chain: List<X509Certificate>, trust: List<X509Certificate>) =
+        ValidateCertificateChainUsingPKIXJvm(customization = JvmSecurity.withRevocationEnabled(false))
+            .invoke(chain, NonEmptyList(trust.map { TrustAnchor(it, null) }))
+
+    @Test
+    fun `a chain that continues above an anchored intermediate is trusted at that intermediate`() = runTest {
+        val validation = validate(listOf(certs.end, certs.intermediate, certs.root), listOf(certs.intermediate))
+        assertIs<CertificationChainValidation.Trusted<TrustAnchor>>(validation)
+        assertEquals(certs.intermediate, validation.trustAnchor.trustedCert)
+    }
+
+    @Test
+    fun `a chain that ends with the anchored intermediate is trusted`() = runTest {
+        val validation = validate(listOf(certs.end, certs.intermediate), listOf(certs.intermediate))
+        assertIs<CertificationChainValidation.Trusted<TrustAnchor>>(validation)
+    }
+
+    @Test
+    fun `an anchor with the same name but another key does not cut the chain`() = runTest {
+        val validation = validate(listOf(certs.end, certs.intermediate, certs.root), listOf(other.intermediate))
+        assertIs<CertificationChainValidation.NotTrusted>(validation)
+    }
+
+    @Test
+    fun `a leaf not issued by the anchored certificate is not trusted`() = runTest {
+        val validation = validate(listOf(other.end, certs.intermediate, certs.root), listOf(certs.intermediate))
+        assertIs<CertificationChainValidation.NotTrusted>(validation)
+    }
+
+    @Test
+    fun `a chain with no anchored certificate is validated unchanged`() = runTest {
+        assertIs<CertificationChainValidation.Trusted<TrustAnchor>>(
+            validate(listOf(certs.end, certs.intermediate), listOf(certs.root)),
+        )
+        assertIs<CertificationChainValidation.NotTrusted>(validate(listOf(certs.end), listOf(certs.root)))
+        assertIs<CertificationChainValidation.NotTrusted>(
+            validate(listOf(certs.end, certs.intermediate, certs.root), listOf(other.root)),
+        )
+    }
+}
