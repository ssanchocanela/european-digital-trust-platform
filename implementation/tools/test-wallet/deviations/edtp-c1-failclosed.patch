--- a/wallet-core/src/main/java/eu/europa/ec/eudi/wallet/trust/MsoMdocCredentialTrustVerifier.kt
+++ b/wallet-core/src/main/java/eu/europa/ec/eudi/wallet/trust/MsoMdocCredentialTrustVerifier.kt
@@ -91,7 +91,11 @@ internal class MsoMdocCredentialTrustVerifier(
         trustResult
     }.onFailure { e ->
         logger?.e(TAG, "MsoMdoc credential trust verification failed", e)
-    }.getOrNull()
+    }.getOrElse { e ->
+            // EDTP: under ENFORCE a thrown verification error (bad signature, revoked signer,
+            // unreachable revocation) must block, not be swallowed as upstream does.
+            if (EdtpTrustEnforce.failClosed) throw e else null
+        }
 
