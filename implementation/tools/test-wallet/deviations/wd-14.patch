@@ -0,0 +1,42 @@
+package eu.europa.ec.eudi.wallet.registration.edtp
+
+import eu.europa.ec.eudi.wallet.registration.RegistrationCertificateDto
+import eu.europa.ec.eudi.wallet.registration.toRegistrationCertificate
+import kotlinx.serialization.json.Json
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertThrows
+import org.junit.Test
+
+// EDTP WD-14: srv_description is read in the shape of ETSI TS 119 475 V1.2.1 Annex B.2.1 (an array of
+// arrays) and in the flat shape this library read before.
+class EdtpWd14Test {
+    private val json = Json { ignoreUnknownKeys = true }
+    private fun decode(srv: String) =
+        json.decodeFromString(RegistrationCertificateDto.serializer(), """{"sub":"X","srv_description":$srv}""")
+
+    @Test
+    fun `the specification's array of arrays is read`() {
+        val rc = decode("""[[{"lang":"es-ES","value":"Servicio"},{"lang":"en","value":"Service"}],[{"lang":"en","value":"Other"}]]""")
+            .toRegistrationCertificate()
+        assertEquals(listOf("Servicio", "Service", "Other"), rc.serviceDescription.map { it.value })
+        assertEquals(listOf("es-ES", "en", "en"), rc.serviceDescription.map { it.language })
+    }
+
+    @Test
+    fun `the flat array is still read`() {
+        val dto = decode("""[{"lang":"en","value":"Service"}]""")
+        assertEquals(listOf("Service"), dto.serviceDescription.map { it.text })
+    }
+
+    @Test
+    fun `an absent srv_description is still empty`() {
+        val dto = json.decodeFromString(RegistrationCertificateDto.serializer(), """{"sub":"X"}""")
+        assertEquals(emptyList<Any>(), dto.serviceDescription)
+    }
+
+    @Test
+    fun `anything else is refused`() {
+        listOf(""""text"""", """{"lang":"en","value":"x"}""", """["text"]""", """[["text"]]""", """[[[{"lang":"en","value":"x"}]]]""")
+            .forEach { bad -> assertThrows(bad, Exception::class.java) { decode(bad) } }
+    }
+}
