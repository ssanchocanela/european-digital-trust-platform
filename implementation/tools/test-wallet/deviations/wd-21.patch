+
+// EDTP WD-21. Returns the EC binding-key algorithm the credential issuer requires for its JWT proof
+// of possession, or null when the wallet's default (ES256) is among the accepted algorithms — in
+// which case the upstream key-creation path is used unchanged. The conversion from the issuer's
+// JOSE identifiers uses the same mapping Wallet Core uses, and only signing algorithms are kept.
+// See deviations.md (WD-21).
+private fun edtpNegotiateProofKeyAlgorithm(
+    offeredDocument: eu.europa.ec.eudi.wallet.issue.openid4vci.Offer.OfferedDocument,
+): org.multipaz.crypto.Algorithm? {
+    val jwt = offeredDocument.configuration.proofTypesSupported[
+        eu.europa.ec.eudi.openid4vci.ProofType.JWT
+    ] as? eu.europa.ec.eudi.openid4vci.ProofTypeMeta.Jwt ?: return null
+    val issuerAlgorithms = jwt.algorithms.mapNotNull { jwsAlgorithm ->
+        runCatching {
+            org.multipaz.crypto.Algorithm.fromJoseAlgorithmIdentifier(jwsAlgorithm.name)
+        }.getOrNull()?.takeIf { it.isSigning }
+    }
+    if (issuerAlgorithms.isEmpty()) return null
+    val es256Jose = org.multipaz.crypto.Algorithm.ESP256.joseAlgorithmIdentifier
+    // The wallet's default binding key is ES256; if the issuer accepts it, keep the upstream path.
+    if (issuerAlgorithms.any { it.joseAlgorithmIdentifier == es256Jose }) return null
+    // Otherwise bind the credential with the algorithm the issuer requires (e.g. ES384 / P-384).
+    return issuerAlgorithms.first()
 }
