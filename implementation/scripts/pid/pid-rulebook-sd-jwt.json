  "payloadSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [
      "vct",
      "family_name",
      "given_name",
      "birthdate",
      "place_of_birth",
      "nationalities",
      "personal_administrative_number",
      "issuing_authority",
      "issuing_country"
    ],
    "$defs": {
      "alpha2": {
        "type": "string",
        "pattern": "^[A-Z]{2}$"
      },
      "date": {
        "type": "string",
        "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
      }
    },
    "properties": {
      "vct": {
        "const": "urn:eudi:pid:1"
      },
      "family_name": {
        "type": "string",
        "minLength": 1
      },
      "given_name": {
        "type": "string",
        "minLength": 1
      },
      "birthdate": {
        "$ref": "#/$defs/date"
      },
      "place_of_birth": {
        "type": "object",
        "minProperties": 1,
        "properties": {
          "country": {
            "$ref": "#/$defs/alpha2"
          },
          "region": {
            "type": "string",
            "minLength": 1
          },
          "locality": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["country"]
      },
      "nationalities": {
        "type": "array",
        "minItems": 1,
        "items": {
          "$ref": "#/$defs/alpha2"
        }
      },
      "personal_administrative_number": {
        "type": "string",
        "minLength": 1
      },
      "birth_family_name": {
        "type": "string",
        "minLength": 1
      },
      "birth_given_name": {
        "type": "string",
        "minLength": 1
      },
      "sex": {
        "enum": [0, 1, 2, 3, 4, 5, 6, 9]
      },
      "address": {
        "type": "object",
        "minProperties": 1,
        "properties": {
          "formatted": {
            "type": "string",
            "minLength": 1
          },
          "street_address": {
            "type": "string",
            "minLength": 1
          },
          "house_number": {
            "type": "string",
            "minLength": 1
          },
          "postal_code": {
            "type": "string",
            "minLength": 1
          },
          "locality": {
            "type": "string",
            "minLength": 1
          },
          "region": {
            "type": "string",
            "minLength": 1
          },
          "country": {
            "$ref": "#/$defs/alpha2"
          }
        }
      },
      "email": {
        "type": "string",
        "pattern": "^[^@\\s]+@[^@\\s]+$"
      },
      "phone_number": {
        "type": "string",
        "pattern": "^\\+[0-9]{6,15}$"
      },
      "document_number": {
        "type": "string",
        "minLength": 1
      },
      "date_of_issuance": {
        "$ref": "#/$defs/date"
      },
      "date_of_expiry": {
        "$ref": "#/$defs/date"
      },
      "issuing_authority": {
        "type": "string",
        "minLength": 1
      },
      "issuing_country": {
        "$ref": "#/$defs/alpha2"
      },
      "issuing_jurisdiction": {
        "type": "string",
        "pattern": "^[A-Z]{2}(-[A-Z0-9]{1,3})?$"
      },
      "trust_anchor": {
        "type": "string",
        "pattern": "^https://"
      },
      "attestation_legal_category": {
        "const": "PID"
      }
    }
  }
