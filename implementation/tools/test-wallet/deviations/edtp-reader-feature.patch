+package eu.europa.ec.readerfeature.ui.scan
+
+import android.content.Context
+import androidx.lifecycle.viewModelScope
+import eu.europa.ec.readerfeature.interactor.ReaderDocument
+import eu.europa.ec.readerfeature.interactor.ReaderScanInteractor
+import eu.europa.ec.readerfeature.interactor.ReaderTransferEvent
+import eu.europa.ec.uilogic.mvi.MviViewModel
+import eu.europa.ec.uilogic.mvi.ViewEvent
+import eu.europa.ec.uilogic.mvi.ViewSideEffect
+import eu.europa.ec.uilogic.mvi.ViewState
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.launch
+import org.koin.core.annotation.KoinViewModel
+
+/** ISO 18013-5 device-engagement prefix. The reader ignores any other QR it happens to see. */
+private const val MDOC_ENGAGEMENT_PREFIX = "mdoc:"
+
+enum class ReaderStatus {
+    /** Camera is up, waiting for a device-engagement QR. */
+    SCANNING,
+
+    /** Engagement parsed; connecting over the chosen (BLE) transport. */
+    CONNECTING,
+
+    /** Transport established; the PID document request has been sent, awaiting the response. */
+    REQUESTING,
+
+    /** Transport established (pre-request). Transient. */
+    CONNECTED,
+
+    /** The response was parsed; disclosed attributes are shown. */
+    COMPLETED,
+
+    /** The holder disconnected or the session ended. */
+    DISCONNECTED,
+
+    /** The engagement, connection or transport failed. */
+    ERROR,
+}
+
+data class State(
+    val isLoading: Boolean = false,
+    val status: ReaderStatus = ReaderStatus.SCANNING,
+    val error: String? = null,
+    val documents: List<ReaderDocument> = emptyList(),
+    // Guards against re-processing: the analyzer fires many frames; only the first valid engagement
+    // starts a session.
+    val engagementHandled: Boolean = false,
+) : ViewState
+
+sealed class Event : ViewEvent {
+    data object Init : Event()
+    data object GoBack : Event()
+
+    /** A QR frame was decoded by the camera analyzer. */
+    data class QrScanned(val context: Context, val payload: String) : Event()
+
+    /** Scan again after a disconnect or error. */
+    data object Retry : Event()
+}
+
+sealed class Effect : ViewSideEffect {
+    sealed class Navigation : Effect() {
+        data object Pop : Navigation()
+    }
+}
+
+/**
+ * Reader (verifier) entry view model.
+ *
+ * Phase 2: scan the holder's engagement QR, connect over BLE, and reflect the transport state. The
+ * document request (Phase 3) and the verification verdict (Phase 4) build on [ReaderTransferEvent].
+ */
+@KoinViewModel
+class ReaderScanViewModel(
+    private val interactor: ReaderScanInteractor,
+) : MviViewModel<Event, State, Effect>() {
+
+    private var eventsJob: Job? = null
+
+    override fun setInitialState(): State = State()
+
+    override fun handleEvents(event: Event) {
+        when (event) {
+            is Event.Init -> observeTransport()
+
+            is Event.QrScanned -> {
+                if (viewState.value.engagementHandled) return
+                if (!event.payload.startsWith(MDOC_ENGAGEMENT_PREFIX)) return
+                setState { copy(engagementHandled = true, status = ReaderStatus.CONNECTING, error = null) }
+                interactor.startEngagement(event.context, event.payload)
+            }
+
+            is Event.Retry -> {
+                interactor.cancel()
+                setState {
+                    copy(
+                        status = ReaderStatus.SCANNING,
+                        error = null,
+                        documents = emptyList(),
+                        engagementHandled = false,
+                    )
+                }
+            }
+
+            is Event.GoBack -> {
+                interactor.cancel()
+                setEffect { Effect.Navigation.Pop }
+            }
+        }
+    }
+
+    private fun observeTransport() {
+        if (eventsJob != null) return
+        eventsJob = viewModelScope.launch {
+            interactor.events().collect { transfer ->
+                when (transfer) {
+                    is ReaderTransferEvent.Connecting ->
+                        setState { copy(status = ReaderStatus.CONNECTING, error = null) }
+
+                    is ReaderTransferEvent.Connected -> {
+                        setState { copy(status = ReaderStatus.CONNECTED, error = null) }
+                        sendDocumentRequest()
+                    }
+
+                    is ReaderTransferEvent.ResponseReceived ->
+                        handleResponse(transfer.deviceResponse, transfer.sessionTranscript)
+
+                    is ReaderTransferEvent.Disconnected ->
+                        setState { copy(status = ReaderStatus.DISCONNECTED) }
+
+                    is ReaderTransferEvent.Error ->
+                        setState {
+                            copy(
+                                status = ReaderStatus.ERROR,
+                                error = transfer.throwable.message ?: "Reader transport error",
+                            )
+                        }
+                }
+            }
+        }
+    }
+
+    private fun sendDocumentRequest() {
+        setState { copy(status = ReaderStatus.REQUESTING, error = null) }
+        viewModelScope.launch {
+            runCatching { interactor.requestDocuments() }
+                .onFailure {
+                    setState {
+                        copy(status = ReaderStatus.ERROR, error = it.message ?: "Request failed")
+                    }
+                }
+        }
+    }
+
+    private fun handleResponse(deviceResponse: ByteArray, sessionTranscript: ByteArray) {
+        viewModelScope.launch {
+            runCatching { interactor.parseResponse(deviceResponse, sessionTranscript) }
+                .onSuccess { docs ->
+                    setState { copy(status = ReaderStatus.COMPLETED, documents = docs, error = null) }
+                }
+                .onFailure {
+                    setState {
+                        copy(status = ReaderStatus.ERROR, error = it.message ?: "Could not read the response")
+                    }
+                }
+        }
+    }
+
+    override fun onCleared() {
+        interactor.cancel()
+        super.onCleared()
+    }
+}
