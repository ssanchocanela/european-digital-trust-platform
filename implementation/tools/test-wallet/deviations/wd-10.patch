+                    )
+            is kotlinx.serialization.json.JsonPrimitive ->
+                if (element.isString) {
+                    element.content
+                } else {
+                    throw kotlinx.serialization.SerializationException("${ETSI19602.LOTE_LEGAL_NOTICE} is not a string")
+                }
+            else -> throw kotlinx.serialization.SerializationException("${ETSI19602.LOTE_LEGAL_NOTICE} is neither a string nor an object")
+        }
+    }
+
+    override fun serialize(encoder: kotlinx.serialization.encoding.Encoder, value: String) {
+        encoder.encodeString(value)
+    }
