+        // EDTP DIAGNOSTIC (diag-issuance). Logging only; no behaviour changes. Prints the client
+        // authentication headers of an outgoing request — the Wallet Instance Attestation, its PoP
+        // and the DPoP proof — so an issuer that rejects them can be handed the exact JWTs. Wallet
+        // Core issues through this client (withKtorHttpClientFactory). Never a body, never any other
+        // header: these carry a TEST wallet instance identity and public keys, no credential and no
+        // PID data. At ERROR through android.util.Log, so WD-7 does not drop it; chunked, because
+        // logcat truncates a line at about 4 KB.
+        install(
+            io.ktor.client.plugins.api.createClientPlugin("EdtpDiagClientAuthHeaders") {
+                onRequest { request, _ ->
+                    listOf(
+                        "OAuth-Client-Attestation",
+                        "OAuth-Client-Attestation-PoP",
+                        "DPoP"
+                    ).forEach { name ->
+                        request.headers[name]?.let { value ->
+                            val target = "${request.method.value} ${request.url.buildString().substringBefore('?')}"
+                            val chunks = value.chunked(3000)
+                            chunks.forEachIndexed { i, chunk ->
+                                android.util.Log.e(
+                                    "EDTP-DIAG",
+                                    "header $name (${i + 1}/${chunks.size}) $target: $chunk"
+                                )
+                            }
+                        }
+                    }
+                }
+                // The body of an ERROR response only (status >= 400): an OAuth / OpenID4VCI error
+                // object, never a credential. Wallet Core turns a failed credential response into
+                // IllegalStateException("CredentialIssuanceError") and drops the issuer's reason,
+                // which is otherwise unrecoverable. Ktor 3 keeps the body, so reading it here does not
+                // consume it for the library. Capped at 2000 characters.
+                onResponse { response ->
+                    if (response.status.value >= 400) {
+                        val target = "${response.call.request.method.value} " +
+                            response.call.request.url.toString().substringBefore('?')
+                        val body = runCatching {
+                            response.bodyAsText()
+                        }.getOrElse { "<unreadable: ${it::class.simpleName}>" }
+                        android.util.Log.e(
+                            "EDTP-DIAG",
+                            "error response ${response.status.value} $target: ${body.take(2000)}"
+                        )
+                    }
+                }
+            }
+        )
     }
