# European Digital Trust Platform V0 — local environment template.
#
#   cp .env.example .env
#   # fill in every value marked CHANGE-ME, then:
#   docker compose up
#
# This file is the only environment file committed. `.env` is ignored.
# Generate each secret with:  openssl rand -base64 32

# --- platform database ------------------------------------------------------------------
PLATFORM_DB_USER=edtp
PLATFORM_DB_PASSWORD=CHANGE-ME-platform-db-password
PLATFORM_DB_NAME=edtp_platform

# --- engine database (separate from the platform's, deliberately: ADR 0001, ADR 0004) ----
ENGINE_DB_USER=eudiplo
ENGINE_DB_PASSWORD=CHANGE-ME-engine-db-password
ENGINE_DB_NAME=eudiplo

# --- platform API -----------------------------------------------------------------------
LOG_LEVEL=info

# Bootstrap administrative key. Creates the first tenant and nothing else: it is refused on
# every tenant-scoped route, so it cannot act as a tenant. Minimum 32 characters.
PLATFORM_ADMIN_API_KEY=CHANGE-ME-at-least-32-characters-long-admin-key

# Public origin of this API. Used to build the same-device wallet return URL, so it must be
# reachable by the browser that starts the flow.
PLATFORM_PUBLIC_URL=http://localhost:3100

# --- wrapped engine ---------------------------------------------------------------------
# Drives every wallet-facing URL the engine emits. For a test with a physical phone this
# MUST be the public HTTPS origin of your tunnel or test host — a wallet cannot reach
# localhost, and the Reference Implementation refuses a self-signed TLS certificate.
# See docs/reference-wallet-testing.md.
ENGINE_PUBLIC_URL=http://localhost:3000
ENGINE_MASTER_SECRET=CHANGE-ME-at-least-32-characters-engine-master-secret
ENGINE_CLIENT_ID=root
ENGINE_CLIENT_SECRET=CHANGE-ME-engine-client-secret
ENGINE_LOG_LEVEL=warn

# The engine's schema lifecycle has two phases, and this switch is the whole of it.
#
#   First start:  true  — only TypeORM synchronisation can create the initial schema. The engine's
#                         BaselineMigration deliberately creates nothing and tells you to set this.
#   Afterwards:   false — the engine's own guidance: "Set to false in production after initial
#                         setup and rely on migrations instead." It ships 45 migrations for exactly
#                         that. Leaving it true lets TypeORM alter the schema on every start.
#
# So: leave it `true` for the first `docker compose up`, then set it to `false`.
# This is the ENGINE's database only. The platform's own database has no auto-synchronisation.
# See docs/eudiplo-integration.md and docs/interop-findings.md A9.
ENGINE_DB_SYNCHRONIZE=true

# Engine credentials per Relying Party Instance, as
#   engineTenantRef=clientId:clientSecret
# separated by commas. One entry per instance: the engine scopes every call to the tenant of
# the presenting token, and the platform maps one engine tenant to one Relying Party Instance
# (ADR 0002 Decision 3).
#
# **The `root` client will not work here.** Verified against v7.6.0: root's token carries
# `roles: ["tenants:manage"]` and `tenant_id: null`, so it is a tenant-*management* credential
# and is refused on every tenant-scoped route. See docs/interop-findings.md A11.
#
# Create a real engine tenant first. It returns the client to use:
#
#   TOK=$(curl -s -X POST http://localhost:3000/api/oauth2/token \
#     -H 'content-type: application/json' \
#     -d '{"grant_type":"client_credentials","client_id":"root","client_secret":"<ENGINE_CLIENT_SECRET>"}' \
#     | jq -r .access_token)
#   curl -s -X POST http://localhost:3000/api/tenant \
#     -H "authorization: Bearer $TOK" -H 'content-type: application/json' \
#     -d '{"id":"rpi-1","name":"Relying Party Instance 1",
#          "roles":["presentation:manage","presentation:request","clients:manage","tenant:admin"]}' \
#     | jq '.client'
#
# Then use the returned clientId and clientSecret below:
#   ENGINE_TENANT_CREDENTIALS=rpi-1=rpi-1-admin:<the-returned-secret>
ENGINE_TENANT_CREDENTIALS=CHANGE-ME-tenant=CHANGE-ME-tenant-admin:CHANGE-ME-engine-tenant-client-secret

# --- feature flags ----------------------------------------------------------------------
# PID-during-issuance: require a PID presentation as the authorization step of an issuance,
# reusing a verification policy (the §7.3 stretch goal). The engine supports it natively, and the
# platform wiring is in place — but it has NOT been exercised end to end with a wallet, so it is
# off by default. Enabling it makes the issuer a Relying Party for the duration of the
# presentation, which carries the RPRC_19 engine limitation with it. See docs/issuer-trust-model.md.
FEATURE_PID_DURING_ISSUANCE=false

# --- web interface ----------------------------------------------------------------------
#
# Two processes, and the split is deliberate: the console is a MANAGEMENT surface and stays on
# localhost, while the start page is the only publicly reachable part — it holds no API credential and
# can do nothing but verify a signed token and offer a link. docs/web-interface-proposal.md §3.3.
#
# The console is optional. The platform API does not need it and does not know about it.

# Where the console reaches the platform API, server-to-server. docker-compose.yml sets this itself
# (http://platform-api:3100), so it is needed only when running the console directly with
# `pnpm console` — which is how the registration screen is used, since that screen needs neither
# Docker nor the platform API.
PLATFORM_API_BASE_URL=http://127.0.0.1:3100

# A tenant API key. It scopes everything the console can see, because the tenant comes from the key.
# Held only by the console process and NEVER sent to a browser.
# The /registration screen does not use it, so the placeholder below is enough to start the console
# for that screen alone; every other screen needs a real key from POST /v1/tenants.
CONSOLE_TENANT_API_KEY=CHANGE-ME-a-tenant-api-key

# The operator login. One shared credential; the console has no user model by design.
CONSOLE_OPERATOR_PASSWORD=CHANGE-ME-at-least-16-characters

# Signs the session cookie. MUST differ from START_TOKEN_SECRET — the console refuses to start if they
# match, because one authenticates the operator and the other vouches for a URI to a public page.
#   openssl rand -hex 32
CONSOLE_SESSION_SECRET=CHANGE-ME-at-least-32-characters-long

# Signs the console → start-page hand-off. Shared by those two processes and nothing else.
#   openssl rand -hex 32
START_TOKEN_SECRET=CHANGE-ME-at-least-32-characters-long-and-different

# Where the PHONE reaches the start page. Leave it unset to run cross-device (QR) only: that needs no
# page of ours. Same-device on a phone needs this, and it must be the public HTTPS origin from the
# gateway allow-list — the wallet refuses cleartext.
# TEST_START_PUBLIC_URL=https://start.<your-test-domain>

# Stamped into the console's run record. Not secrets; unset simply shows as "<unset>".
# PLATFORM_COMMIT=
# ENGINE_IMAGE_DIGEST=sha256:8dd60a2fe38f7c6f91b6a3c4003182fbb1a3659a5a7a697166ad0f0c5120c667

# --- registration session (optional) ----------------------------------------------------
#
# Enrolment at the reference RP Registration Service, driven by the console's /registration screen
# or by `pnpm registration`. Both read the same files, so an interrupted session resumes either way.
#
# The working directory holds the session state, `hash_pid` and the issued certificates, all mode
# 600. It defaults to ~/.edtp/registration and is OUTSIDE the repository on purpose: hash_pid and a
# PKCS#12 passphrase are secrets, and a path under $HOME cannot be committed by accident at all.
# EDTP_REGISTRATION_DIR=
# REGISTRATION_ENTITY_FILE=            # defaults to <dir>/entity.json
# REGISTRY_BASE_URL=                   # defaults to the reference service
#
# HASH_PID is deliberately absent. It is obtained by presenting a PID, stored by the login, and
# never belongs in a .env file that a dozen processes read.
