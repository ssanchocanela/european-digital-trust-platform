+
+package eu.europa.ec.readerfeature.interactor
+
+import android.content.Context
+import org.multipaz.crypto.X509Cert
+
+/**
+ * Issuer trust anchors for the reader (verifier) side — the IACA / document-signer anchors a PID's
+ * MSO must chain to. This is the *opposite* store from the holder's reader-trust store.
+ *
+ * Anchors are loaded from the bundled PEM `res/raw/edtp_reader_trust.pem`. The build ships one anchor:
+ * the "EDTP Development PID Provider CA - TEST ONLY", extracted from the published PID Providers LoTE,
+ * which the test PID issuer's signing certificates chain to. `build.sh --reader-trust <file>` replaces
+ * the file's contents. If it holds no usable certificate, no anchors are returned and the "Trusted
+ * issuer" check reports SKIPPED rather than PASS.
+ *
+ * The resource is referenced through `R.raw` (not `getIdentifier` by name) on purpose: the release
+ * build shrinks resources (`isShrinkResources = true`), and a resource reached only by a string name
+ * is not seen as used and is stripped — which silently removed this anchor from a release APK. A
+ * direct `R.raw` reference is kept.
+ *
+ * `TEST` only; never a production anchor (CLAUDE.md §7).
+ */
+interface ReaderTrustStore {
+    fun anchors(): List<X509Cert>
+}
+
+class ReaderTrustStoreImpl(
+    private val context: Context,
+) : ReaderTrustStore {
+
+    private val loaded: List<X509Cert> by lazy { load() }
+
+    override fun anchors(): List<X509Cert> = loaded
+
+    private fun load(): List<X509Cert> {
+        val pem = runCatching {
+            context.resources.openRawResource(eu.europa.ec.readerfeature.R.raw.edtp_reader_trust)
+                .bufferedReader().use { it.readText() }
+        }.getOrElse { return emptyList() }
+        // Parse every PEM certificate block, ignoring comment lines around them.
+        return PEM_CERT.findAll(pem)
+            .mapNotNull { match -> runCatching { X509Cert.fromPem(match.value) }.getOrNull() }
+            .toList()
+    }
+
+    private companion object {
+        val PEM_CERT = Regex(
+            "-----BEGIN CERTIFICATE-----.*?-----END CERTIFICATE-----",
+            RegexOption.DOT_MATCHES_ALL,
+        )
+    }
+}
