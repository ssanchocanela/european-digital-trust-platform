+++ b/network-logic/src/main/java/eu/europa/ec/networklogic/di/EdtpSignedMetadataAccept.kt
@@ -0,0 +1,44 @@
+/*
+ * EDTP deviation WD-11. Not upstream.
+ */
+
+package eu.europa.ec.networklogic.di
+
+import io.ktor.client.plugins.api.Send
+import io.ktor.client.plugins.api.createClientPlugin
+import io.ktor.http.HttpHeaders
+import io.ktor.http.encodedPath
+
+private const val ISSUER_METADATA_PATH = "/.well-known/openid-credential-issuer"
+private const val SIGNED_METADATA = "application/jwt"
+
+/**
+ * The `Accept` header a Credential Issuer Metadata request should carry, when it has to be changed.
+ *
+ * This build requires signed metadata, and the issuance library then asks for `application/jwt`
+ * alone. But the HTTP client the app hands it installs `ContentNegotiation` for JSON, which appends
+ * `application/json` to every request — so on the wire the wallet says it takes either, with no
+ * preference. OpenID4VCI 1.0 section 12.2.2 obliges an issuer to support the unsigned form and only
+ * recommends matching the `Accept` header, so an issuer may answer JSON; the wallet then refuses
+ * the answer it said it accepted.
+ *
+ * Returns `application/jwt` for a metadata request that asked for it, and `null` for anything else,
+ * which is left as it is.
+ */
+internal fun signedMetadataAccept(encodedPath: String, accept: List<String>): String? {
+    if (!encodedPath.contains(ISSUER_METADATA_PATH)) return null
+    val asked = accept.flatMap { it.split(",") }.map { it.substringBefore(";").trim().lowercase() }
+    return if (SIGNED_METADATA in asked && asked.any { it != SIGNED_METADATA }) SIGNED_METADATA else null
+}
+
+/** Applies [signedMetadataAccept] as the request leaves, after every other plugin has had its say. */
+val EdtpSignedMetadataAccept = createClientPlugin("EdtpSignedMetadataAccept") {
+    on(Send) { request ->
+        val accept = request.headers.getAll(HttpHeaders.Accept).orEmpty()
+        signedMetadataAccept(request.url.encodedPath, accept)?.let { only ->
+            request.headers.remove(HttpHeaders.Accept)
+            request.headers.append(HttpHeaders.Accept, only)
+        }
+        proceed(request)
+    }
+}
