+package eu.europa.ec.uilogic.component.content
+
+import androidx.compose.foundation.background
+import androidx.compose.foundation.layout.fillMaxWidth
+import androidx.compose.foundation.layout.padding
+import androidx.compose.material3.Text
+import androidx.compose.runtime.Composable
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.graphics.Color
+import androidx.compose.ui.text.font.FontWeight
+import androidx.compose.ui.text.style.TextAlign
+import androidx.compose.ui.unit.dp
+import androidx.compose.ui.unit.sp
+import eu.europa.ec.uilogic.BuildConfig
+
+/**
+ * States, on every screen, that this is a modified build and which deviations are compiled in.
+ *
+ * Renders nothing in an unmodified build, so this file is inert unless the `edtptest` flavour is
+ * selected: `BuildConfig.EDTP_BUILD` is false in every other flavour.
+ *
+ * It is deliberately placed in [ContentScreen], which every screen in the app uses, rather than on
+ * individual screens. A banner that can be navigated away from would make a screenshot ambiguous
+ * about which build produced it, and the whole point is that no result from this build can be
+ * mistaken for one from the official Reference Wallet.
+ *
+ * The deviation text comes from the build, not from a constant here, so the banner cannot drift
+ * from what was actually compiled.
+ */
+@Composable
+fun EdtpModifiedBuildBanner(modifier: Modifier = Modifier) {
+    if (!BuildConfig.EDTP_BUILD) {
+        return
+    }
+
+    Text(
+        text = "EDTP TEST WALLET · MODIFIED REFERENCE BUILD · NOT THE OFFICIAL EUDI WALLET" +
+                " · deviations: ${BuildConfig.EDTP_DEVIATIONS}",
+        modifier = modifier
+            .fillMaxWidth()
+            .background(BANNER_BACKGROUND)
+            .padding(horizontal = 8.dp, vertical = 4.dp),
+        color = Color.White,
+        fontSize = 10.sp,
+        lineHeight = 13.sp,
+        fontWeight = FontWeight.Bold,
+        textAlign = TextAlign.Center,
+    )
+}
+
+/**
+ * Fixed rather than taken from the theme. The banner has to be conspicuous in both light and dark
+ * themes, and a themed colour would let a future theme change quietly make it blend in.
+ */
+private val BANNER_BACKGROUND = Color(0xFF8A1C1C)
