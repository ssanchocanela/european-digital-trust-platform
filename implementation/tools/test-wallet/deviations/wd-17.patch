+package eu.europa.ec.eudi.wallet.registration
+
+import eu.europa.ec.eudi.wallet.internal.d
+import eu.europa.ec.eudi.wallet.logging.Logger
+import io.ktor.client.HttpClient
+import io.ktor.client.call.replaceResponse
+import io.ktor.client.statement.HttpReceivePipeline
+import io.ktor.http.ContentType
+import io.ktor.http.Headers
+import io.ktor.http.HttpHeaders
+import io.ktor.http.contentType
+import io.ktor.utils.io.ByteReadChannel
+import io.ktor.utils.io.InternalAPI
+import io.ktor.utils.io.toByteArray
+import java.util.Base64
+
+/**
+ * EDTP WD-17 — a RELAXATION, not a fix. draft-ietf-oauth-status-list §8.2 requires a Status List Token
+ * in CWT format to be sent as its raw binary encoding. Some servers send it base64url-encoded as text.
+ * This decodes such a body back to binary before the status library reads it, and nothing else: only a
+ * response typed `application/statuslist+cwt`, only when the whole body is base64url text, and only when
+ * what it decodes to begins as a COSE_Sign1 (tagged, 0xd2, or untagged, 0x84). A binary body — the
+ * specification's — starts with one of those non-ASCII bytes and is passed through untouched. The token
+ * is then verified exactly as a binary one is: this changes the transport encoding, never what is trusted.
+ */
+@OptIn(InternalAPI::class)
+internal fun HttpClient.edtpToleratingBase64UrlCwt(logger: Logger?): HttpClient = apply {
+    // The response is replaced as a whole, with its Content-Length corrected: the client checks the body
+    // it hands on against that header.
+    receivePipeline.intercept(HttpReceivePipeline.After) { response ->
+        if (response.contentType()?.match(STATUS_LIST_CWT) != true) return@intercept
+        val received = response.rawContent.toByteArray()
+        val decoded = edtpDecodeBase64UrlCwt(received)
+        if (decoded !== received) {
+            logger?.d(TAG, "status list token was sent base64url-encoded as text; decoded (EDTP WD-17)")
+        }
+        val headers = Headers.build {
+            response.headers.forEach { name, values ->
+                if (!name.equals(HttpHeaders.ContentLength, ignoreCase = true)) appendAll(name, values)
+            }
+            append(HttpHeaders.ContentLength, decoded.size.toString())
+        }
+        proceedWith(response.call.replaceResponse(headers) { ByteReadChannel(decoded) }.response)
+    }
+}
+
+/** Returns [body] decoded when it is base64url text of a COSE_Sign1, and [body] itself otherwise. */
+internal fun edtpDecodeBase64UrlCwt(body: ByteArray): ByteArray {
+    val text = body.toString(Charsets.US_ASCII).trim()
+    if (text.isEmpty() || !BASE64URL.matches(text)) return body
+    val decoded = runCatching { Base64.getUrlDecoder().decode(text.trimEnd('=')) }.getOrNull() ?: return body
+    val first = decoded.firstOrNull()?.toInt()?.and(0xff) ?: return body
+    return if (first == COSE_SIGN1_TAGGED || first == COSE_SIGN1_UNTAGGED) decoded else body
+}
+
+private val STATUS_LIST_CWT = ContentType.parse("application/statuslist+cwt")
+private val BASE64URL = Regex("^[A-Za-z0-9_-]+=*$")
+private const val COSE_SIGN1_TAGGED = 0xd2
+private const val COSE_SIGN1_UNTAGGED = 0x84
+private const val TAG = "RegistrationCertChecks"
