+    override suspend fun toggleEdtpTrustLayer(type: SettingsMenuItemType) {
+        val (key, layer) = when (type) {
+            SettingsMenuItemType.EDTP_TRUST_C1 -> "C1" to eu.europa.ec.edtp.trust.TrustLayer.C1_SIGNATURES
+            SettingsMenuItemType.EDTP_TRUST_C2 -> "C2" to eu.europa.ec.edtp.trust.TrustLayer.C2_CHAIN
+            SettingsMenuItemType.EDTP_TRUST_C3 -> "C3" to eu.europa.ec.edtp.trust.TrustLayer.C3_REVOCATION
+            else -> return
+        }
+        val newValue = !prefKeys.getTrustLayerEnabled(key)
+        prefKeys.setTrustLayerEnabled(key, newValue)
+        // Live: no restart needed — the observer reads TrustConfigHolder on every flow.
+        eu.europa.ec.edtp.trust.TrustConfigHolder.setMode(
+            layer,
+            if (newValue) eu.europa.ec.edtp.trust.TrustMode.OBSERVE
+            else eu.europa.ec.edtp.trust.TrustMode.OFF
+        )
+    }
+
