{
  "name": "@edtp/implementation",
  "version": "0.1.0",
  "private": true,
  "description": "European Digital Trust Platform V0 \u2014 platform foundations and Verification as a Service",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "clean": "tsc --build tsconfig.build.json --clean && rm -rf coverage",
    "typecheck": "tsc --build tsconfig.build.json && tsc -p tsconfig.tests.json",
    "test": "vitest run --project unit",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:adapter": "vitest run --project adapter-contract",
    "test:all": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "boundaries": "node scripts/check-boundaries.mjs",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "node --experimental-strip-types packages/persistence/src/migrate-cli.ts",
    "api:openapi": "node --experimental-strip-types apps/platform-api/src/openapi-cli.ts",
    "registration": "node packages/registration-client/dist/cli.js",
    "console": "node --env-file=.env apps/operator-console/dist/main.js",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm run boundaries && pnpm run confidentiality && pnpm run test:unit && pnpm run test:integration",
    "start:dev": "node --experimental-strip-types --watch apps/platform-api/src/main.ts",
    "start": "node apps/platform-api/dist/main.js",
    "confidentiality": "node scripts/check-confidentiality.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.3",
    "@types/node": "22.20.0",
    "@types/pg": "8.15.6",
    "drizzle-kit": "0.31.8",
    "embedded-postgres": "17.5.0-beta.15",
    "pg": "8.16.3",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
