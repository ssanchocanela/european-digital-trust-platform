+
+package eu.europa.ec.readerfeature.interactor
+
+import android.content.Context
+import androidx.core.content.ContextCompat
+import com.android.identity.android.mdoc.deviceretrieval.VerificationHelper
+import com.android.identity.android.mdoc.transport.DataTransportOptions
+import eu.europa.ec.resourceslogic.provider.ResourceProvider
+import kotlinx.coroutines.flow.Flow
+import kotlinx.coroutines.flow.MutableSharedFlow
+import kotlinx.coroutines.flow.asSharedFlow
+import org.multipaz.cbor.Cbor
+import org.multipaz.crypto.Algorithm
+import org.multipaz.mdoc.connectionmethod.MdocConnectionMethod
+import org.multipaz.mdoc.connectionmethod.MdocConnectionMethodBle
+import org.multipaz.mdoc.request.DeviceRequestGenerator
+import org.multipaz.mdoc.response.DeviceResponseParser
+
+/**
+ * What the reader (verifier) transport reports back to the UI. A thin, Multipaz-free surface: the
+ * view model never touches `VerificationHelper`, so the BLE/engagement machinery stays behind this
+ * boundary.
+ */
+sealed interface ReaderTransferEvent {
+    /** The holder's device engagement was parsed; the reader is connecting over the chosen transport. */
+    data object Connecting : ReaderTransferEvent
+
+    /** The transport is up. Phase 3 sends the document request at this point. */
+    data object Connected : ReaderTransferEvent
+
+    /**
+     * A device response arrived. Carried with the session transcript so Phase 3/4 can parse and
+     * verify it with [org.multipaz.mdoc.response.DeviceResponseParser]. Not yet consumed in Phase 2.
+     */
+    data class ResponseReceived(
+        val deviceResponse: ByteArray,
+        val sessionTranscript: ByteArray,
+    ) : ReaderTransferEvent
+
+    data class Disconnected(val transportSpecificTermination: Boolean) : ReaderTransferEvent
+
+    data class Error(val throwable: Throwable) : ReaderTransferEvent
+}
+
+/** One disclosed element, rendered Multipaz-free for the UI. [value] is the CBOR diagnostic text. */
+data class ReaderAttribute(
+    val namespace: String,
+    val element: String,
+    val value: String,
+)
+
+/** Outcome of a single verification check. SKIPPED = could not be evaluated (e.g. no trust anchor). */
+enum class CheckOutcome { PASS, FAIL, SKIPPED }
+
+/** One line of the verification verdict for a document. */
+data class ReaderCheck(
+    val name: String,
+    val outcome: CheckOutcome,
+    val detail: String? = null,
+)
+
+/**
+ * One document in the response, with its disclosed attributes and the verification verdict. The
+ * checks are computed Multipaz-free from the parsed `Document`, so the UI shows exactly what was
+ * verified — it never dresses a failing read up as a success.
+ */
+data class ReaderDocument(
+    val docType: String,
+    val attributes: List<ReaderAttribute>,
+    val checks: List<ReaderCheck>,
+)
+
+interface ReaderScanInteractor {
+    /** Hot stream of transport events. Collected by the view model for the life of the screen. */
+    fun events(): Flow<ReaderTransferEvent>
+
+    /**
+     * Start an ISO 18013-5 reader session from a scanned device-engagement QR. Builds the
+     * [VerificationHelper], feeds it the engagement, and on the engagement callback connects over
+     * the first BLE transport the holder offered. Idempotent per session: a second call cancels the
+     * previous helper first.
+     */
+    fun startEngagement(context: Context, engagementQr: String)
+
+    /**
+     * Build and send the document request on the live session (PID and mDL). Called once the
+     * transport is up. Unsigned (no reader authentication) in this cut; the holder returns only the
+     * documents it holds, so asking for both is safe. The response arrives via
+     * [ReaderTransferEvent.ResponseReceived]. Suspending: `addDocumentRequest` is a coroutine.
+     */
+    suspend fun requestDocuments()
+
+    /**
+     * Parse a device response into a Multipaz-free list of documents and their disclosed attributes.
+     * Suspending: `DeviceResponseParser.parse` is a coroutine. The verification verdict (issuer
+     * signature, trust anchor, validity, device auth) is read from the same parse in Phase 4.
+     */
+    suspend fun parseResponse(deviceResponse: ByteArray, sessionTranscript: ByteArray): List<ReaderDocument>
+
+    /** Tear down the current session and release the transport. */
+    fun cancel()
+}
+
+class ReaderScanInteractorImpl(
+    @Suppress("unused") private val resourceProvider: ResourceProvider,
+    private val trustStore: ReaderTrustStore,
+) : ReaderScanInteractor {
+
+    // replay = 0: events are transient. A small buffer so a burst (Connecting→Connected) is never
+    // dropped if the collector is momentarily busy; tryEmit then always succeeds.
+    private val _events = MutableSharedFlow<ReaderTransferEvent>(
+        replay = 0,
+        extraBufferCapacity = 16,
+    )
+
+    private var verificationHelper: VerificationHelper? = null
+
+    override fun events(): Flow<ReaderTransferEvent> = _events.asSharedFlow()
+
+    override fun startEngagement(context: Context, engagementQr: String) {
+        cancel()
+
+        val listener = object : VerificationHelper.Listener {
+            override fun onReaderEngagementReady(readerEngagement: ByteArray) {
+                // Reverse engagement only; unused in the QR-led flow.
+            }
+
+            override fun onDeviceEngagementReceived(
+                connectionMethods: List<MdocConnectionMethod>,
+            ) {
+                // Prefer a BLE transport (the capability's requirement); fall back to whatever the
+                // holder offered first so the failure, if any, is a connect error rather than silence.
+                val method = connectionMethods.firstOrNull { it is MdocConnectionMethodBle }
+                    ?: connectionMethods.firstOrNull()
+                if (method == null) {
+                    _events.tryEmit(
+                        ReaderTransferEvent.Error(
+                            IllegalStateException("The holder offered no connection method.")
+                        )
+                    )
+                    return
+                }
+                _events.tryEmit(ReaderTransferEvent.Connecting)
+                runCatching { verificationHelper?.connect(method) }
+                    .onFailure { _events.tryEmit(ReaderTransferEvent.Error(it)) }
+            }
+
+            override fun onMoveIntoNfcField() {
+                // NFC handover is a later phase.
+            }
+
+            override fun onDeviceConnected() {
+                _events.tryEmit(ReaderTransferEvent.Connected)
+            }
+
+            override fun onDeviceDisconnected(transportSpecificTermination: Boolean) {
+                _events.tryEmit(ReaderTransferEvent.Disconnected(transportSpecificTermination))
+            }
+
+            override fun onResponseReceived(deviceResponseBytes: ByteArray) {
+                val transcript = verificationHelper?.sessionTranscript ?: ByteArray(0)
+                _events.tryEmit(
+                    ReaderTransferEvent.ResponseReceived(
+                        deviceResponse = deviceResponseBytes,
+                        sessionTranscript = transcript,
+                    )
+                )
+            }
+
+            override fun onError(error: Throwable) {
+                _events.tryEmit(ReaderTransferEvent.Error(error))
+            }
+        }
+
+        runCatching {
+            val helper = VerificationHelper.Builder(
+                context,
+                listener,
+                ContextCompat.getMainExecutor(context),
+            )
+                .setDataTransportOptions(DataTransportOptions.Builder().build())
+                .build()
+            verificationHelper = helper
+            helper.setDeviceEngagementFromQrCode(engagementQr)
+        }.onFailure { _events.tryEmit(ReaderTransferEvent.Error(it)) }
+    }
+
+    override suspend fun requestDocuments() {
+        val helper = verificationHelper
+            ?: throw IllegalStateException("No active reader session.")
+        // Unsigned request (no reader authentication) in this cut: readerKey/cert chain are null and
+        // the signature algorithm is UNSET, so nothing is signed — the holder discloses without
+        // verifying a reader identity. Request-side reader auth is a later phase. One docRequest per
+        // document type (PID and mDL); the holder returns only those it has.
+        val generator = DeviceRequestGenerator(helper.sessionTranscript)
+        for ((docType, items) in REQUESTED_DOCUMENTS) {
+            generator.addDocumentRequest(
+                docType,
+                items,
+                requestInfo = null,
+                readerKey = null,
+                signatureAlgorithm = Algorithm.UNSET,
+                readerKeyCertificateChain = null,
+            )
+        }
+        helper.sendRequest(generator.generate())
+    }
+
+    override suspend fun parseResponse(
+        deviceResponse: ByteArray,
+        sessionTranscript: ByteArray,
+    ): List<ReaderDocument> {
+        val parsed = DeviceResponseParser(deviceResponse, sessionTranscript).parse()
+        val result = mutableListOf<ReaderDocument>()
+        for (document in parsed.documents) {
+            val attributes = document.issuerNamespaces.flatMap { namespace ->
+                document.getIssuerEntryNames(namespace).map { element ->
+                    val value = runCatching {
+                        Cbor.toDiagnostics(document.getIssuerEntryData(namespace, element))
+                    }.getOrElse { "<unreadable>" }
+                    ReaderAttribute(namespace = namespace, element = element, value = value)
+                }
+            }
+            result += ReaderDocument(
+                docType = document.docType,
+                attributes = attributes,
+                checks = buildVerdict(document),
+            )
+        }
+        return result
+    }
+
+    /**
+     * The verification verdict for one document, read from the parsed [DeviceResponseParser.Document]
+     * (issuer signature, digest integrity, validity, device authentication) plus a trust-anchor check
+     * of the issuer certificate chain against [trustStore]. Each is reported as PASS/FAIL/SKIPPED; a
+     * failing check is never hidden.
+     */
+    private suspend fun buildVerdict(document: DeviceResponseParser.Document): List<ReaderCheck> {
+        val checks = mutableListOf<ReaderCheck>()
+
+        checks += ReaderCheck(
+            name = "Issuer signature (MSO)",
+            outcome = if (document.issuerSignedAuthenticated) CheckOutcome.PASS else CheckOutcome.FAIL,
+        )
+
+        val digestFailures = document.numIssuerEntryDigestMatchFailures
+        checks += ReaderCheck(
+            name = "Data integrity (digests)",
+            outcome = if (digestFailures == 0) CheckOutcome.PASS else CheckOutcome.FAIL,
+            detail = if (digestFailures > 0) "$digestFailures element(s) failed the digest match" else null,
+        )
+
+        val now = kotlin.time.Clock.System.now()
+        val from = document.validityInfoValidFrom
+        val until = document.validityInfoValidUntil
+        val withinValidity = now >= from && now <= until
+        checks += ReaderCheck(
+            name = "Validity period",
+            outcome = if (withinValidity) CheckOutcome.PASS else CheckOutcome.FAIL,
+            detail = "valid $from … $until",
+        )
+
+        checks += ReaderCheck(
+            name = "Device authentication",
+            outcome = if (document.deviceSignedAuthenticated) CheckOutcome.PASS else CheckOutcome.FAIL,
+        )
+
+        val anchors = trustStore.anchors()
+        checks += if (anchors.isEmpty()) {
+            ReaderCheck(
+                name = "Trusted issuer",
+                outcome = CheckOutcome.SKIPPED,
+                detail = "no trust anchor configured",
+            )
+        } else {
+            // The chain reaches trust when one of its certificates IS a configured anchor (anchor in
+            // chain) or is SIGNED BY one (the anchor's key verifies a cert in the chain — e.g. the
+            // document-signer leaf signed by our PID Provider CA). The MSO signature check above only
+            // proves the response was signed by the document-signer cert in this chain, not that that
+            // signer is trusted.
+            val chainCerts = document.issuerCertificateChain?.certificates.orEmpty()
+            val trusted = anchors.any { anchor ->
+                chainCerts.any { it == anchor } ||
+                    chainCerts.any { cert ->
+                        runCatching { cert.verify(anchor.ecPublicKey) }.isSuccess
+                    }
+            }
+            ReaderCheck(
+                name = "Trusted issuer",
+                outcome = if (trusted) CheckOutcome.PASS else CheckOutcome.FAIL,
+                detail = if (!trusted) "chain does not reach a configured anchor" else null,
+            )
+        }
+
+        return checks
+    }
+
+    override fun cancel() {
+        runCatching { verificationHelper?.disconnect() }
+        verificationHelper = null
+    }
+
+    private companion object {
+        const val PID_DOC_TYPE = "eu.europa.ec.eudi.pid.1"
+        const val MDL_DOC_TYPE = "org.iso.18013.5.1.mDL"
+        const val MDL_NAMESPACE = "org.iso.18013.5.1"
+
+        // Fixed demo attribute sets; `false` = do not ask the holder to retain the value. Elements
+        // the holder does not have are simply absent from the response. age_over_18 is deliberately
+        // NOT requested from the PID: it does not exist there (PID Rulebook v1.1, CLAUDE.md §6.1).
+        // The PID namespace equals its docType; the mDL namespace is org.iso.18013.5.1.
+        val PID_ITEMS: Map<String, Map<String, Boolean>> = mapOf(
+            PID_DOC_TYPE to mapOf(
+                "family_name" to false,
+                "given_name" to false,
+                "birth_date" to false,
+                "nationality" to false,
+                "issuing_country" to false,
+                "issuing_authority" to false,
+                "expiry_date" to false,
+            ),
+        )
+        val MDL_ITEMS: Map<String, Map<String, Boolean>> = mapOf(
+            MDL_NAMESPACE to mapOf(
+                "family_name" to false,
+                "given_name" to false,
+                "birth_date" to false,
+                "document_number" to false,
+                "issuing_country" to false,
+                "issuing_authority" to false,
+                "issue_date" to false,
+                "expiry_date" to false,
+                "driving_privileges" to false,
+                "un_distinguishing_sign" to false,
+            ),
+        )
+
+        // One entry per requested document type. mDL is just another entry — no structural change.
+        val REQUESTED_DOCUMENTS: Map<String, Map<String, Map<String, Boolean>>> = mapOf(
+            PID_DOC_TYPE to PID_ITEMS,
+            MDL_DOC_TYPE to MDL_ITEMS,
+        )
+    }
+}
