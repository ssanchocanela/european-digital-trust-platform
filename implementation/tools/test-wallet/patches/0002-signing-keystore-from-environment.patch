diff --git a/app/build.gradle.kts b/app/build.gradle.kts
index 3a8c5eb..0de27dc 100644
--- a/app/build.gradle.kts
+++ b/app/build.gradle.kts
@@ -28,12 +28,22 @@ android {
     signingConfigs {
         create("release") {
 
-            storeFile = file("${rootProject.projectDir}/sign")
+            // EDTP modification. The keystore path comes from the environment so a build can be
+            // signed with our own key without a keystore ever sitting inside the checkout — and
+            // so nothing signed by us can be mistaken for an official build. Upstream's path is
+            // the fallback, so an unmodified invocation behaves exactly as upstream does.
+            storeFile = file(
+                System.getenv("ANDROID_KEYSTORE_PATH") ?: "${rootProject.projectDir}/sign"
+            )
 
             keyAlias = getProperty("androidKeyAlias") ?: System.getenv("ANDROID_KEY_ALIAS")
             keyPassword = getProperty("androidKeyPassword") ?: System.getenv("ANDROID_KEY_PASSWORD")
-            storePassword =
-                getProperty("androidKeyPassword") ?: System.getenv("ANDROID_KEY_PASSWORD")
+            // EDTP modification. A keystore whose store password differs from its key password is
+            // ordinary; upstream assumes they are the same. ANDROID_STORE_PASSWORD is consulted
+            // first and falls back to upstream's behaviour when it is not set.
+            storePassword = getProperty("androidKeyPassword")
+                ?: System.getenv("ANDROID_STORE_PASSWORD")
+                ?: System.getenv("ANDROID_KEY_PASSWORD")
 
             enableV2Signing = true
         }
