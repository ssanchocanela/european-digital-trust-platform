+        /**
+         * EDTP WD-15. ETSI TS 119 602 lets a list's service digital identity be the certificate that
+         * verifies the provider's signature — for a registration certificate, the signing certificate
+         * itself (Annex G). PKIX builds no path whose leaf is the anchor, so such a signer could never be
+         * trusted. When the leaf is byte for byte one of the trust anchors' certificates, it is trusted
+         * directly at that anchor, provided it is within its validity period now. Nothing else changes.
+         */
+        internal fun X509Certificate.directTrustAnchor(trustAnchors: List<TrustAnchor>): TrustAnchor? {
+            val leaf = encoded
+            return trustAnchors.firstOrNull { it.trustedCert?.encoded?.contentEquals(leaf) == true }
+        }
+
+        private fun TrustAnchor.directlyTrusted(leaf: X509Certificate): CertificationChainValidation<TrustAnchor> =
+            try {
+                leaf.checkValidity()
+                CertificationChainValidation.Trusted(this)
+            } catch (e: CertificateException) {
+                e.notTrusted()
+            }
