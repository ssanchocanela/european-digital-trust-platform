+/**
+ * EDTP deviation WD-10. Not upstream.
+ *
+ * Reads a `LoTELegalNotice` written as a multilingual character string — `{"value": …, "lang": …}`,
+ * which is what ETSI TS 119 602 V1.1.1 clause 6.3.11 requires — as well as the plain string this
+ * model expects, and keeps the text. Without it a list carrying a multilingual legal notice does
+ * not parse at all, so none of its trust anchors is loaded.
+ *
+ * The property stays a `String`, so the class is unchanged for everything compiled against it.
+ */
+internal object EdtpLegalNoticeTextSerializer : kotlinx.serialization.KSerializer<String> {
+    override val descriptor: kotlinx.serialization.descriptors.SerialDescriptor =
+        kotlinx.serialization.descriptors.PrimitiveSerialDescriptor(
+            "EdtpLoTELegalNotice",
+            kotlinx.serialization.descriptors.PrimitiveKind.STRING,
+        )
+
+    override fun deserialize(decoder: kotlinx.serialization.encoding.Decoder): String {
+        val element = (decoder as kotlinx.serialization.json.JsonDecoder).decodeJsonElement()
+        return when (element) {
+            is kotlinx.serialization.json.JsonObject ->
+                (element[ETSI19602.STRING_VALUE] as? kotlinx.serialization.json.JsonPrimitive)
+                    ?.takeIf { it.isString }
+                    ?.content
+                    ?: throw kotlinx.serialization.SerializationException(
+                        "${ETSI19602.LOTE_LEGAL_NOTICE} has no ${ETSI19602.STRING_VALUE}",
+                    )
+            is kotlinx.serialization.json.JsonPrimitive ->
+                if (element.isString) {
+                    element.content
+                } else {
+                    throw kotlinx.serialization.SerializationException("${ETSI19602.LOTE_LEGAL_NOTICE} is not a string")
+                }
+            else -> throw kotlinx.serialization.SerializationException("${ETSI19602.LOTE_LEGAL_NOTICE} is neither a string nor an object")
+        }
+    }
+
+    override fun serialize(encoder: kotlinx.serialization.encoding.Encoder, value: String) {
+        encoder.encodeString(value)
+    }
+}
