+package eu.europa.ec.eudi.etsi1196x2.consultation.edtp
+
+import eu.europa.ec.eudi.etsi1196x2.consultation.CertificationChainValidation
+import eu.europa.ec.eudi.etsi1196x2.consultation.JvmSecurity
+import eu.europa.ec.eudi.etsi1196x2.consultation.NonEmptyList
+import eu.europa.ec.eudi.etsi1196x2.consultation.Sample
+import eu.europa.ec.eudi.etsi1196x2.consultation.ValidateCertificateChainUsingPKIXJvm
+import kotlinx.coroutines.test.runTest
+import org.bouncycastle.asn1.x500.X500Name
+import org.bouncycastle.cert.jcajce.JcaX509CertificateConverter
+import org.bouncycastle.cert.jcajce.JcaX509v3CertificateBuilder
+import org.bouncycastle.operator.jcajce.JcaContentSignerBuilder
+import java.math.BigInteger
+import java.security.KeyPairGenerator
+import java.security.cert.CertificateExpiredException
+import java.security.cert.TrustAnchor
+import java.security.cert.X509Certificate
+import java.util.Date
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertIs
+
+// EDTP WD-15: a leaf that is byte for byte a trust anchor's certificate is trusted directly, within
+// its validity period. The JDK's default provider, which is what the wallet uses.
+class EdtpWd15Test {
+    private val certs = Sample.create()
+    private val other = Sample.create() // the same names, other keys
+
+    private suspend fun validate(chain: List<X509Certificate>, trust: List<X509Certificate>) =
+        ValidateCertificateChainUsingPKIXJvm(customization = JvmSecurity.withRevocationEnabled(false))
+            .invoke(chain, NonEmptyList(trust.map { TrustAnchor(it, null) }))
+
+    @Test
+    fun `a leaf that is itself the anchor is trusted at it`() = runTest {
+        val validation = validate(listOf(certs.end), listOf(certs.end))
+        assertIs<CertificationChainValidation.Trusted<TrustAnchor>>(validation)
+        assertEquals(certs.end, validation.trustAnchor.trustedCert)
+    }
+
+    @Test
+    fun `a leaf that is the anchor is trusted whatever follows it`() = runTest {
+        val validation = validate(listOf(certs.end, certs.intermediate), listOf(certs.end))
+        assertIs<CertificationChainValidation.Trusted<TrustAnchor>>(validation)
+    }
+
+    @Test
+    fun `a leaf with the anchor's name but another key is not trusted`() = runTest {
+        assertIs<CertificationChainValidation.NotTrusted>(validate(listOf(other.end, other.intermediate), listOf(certs.end)))
+    }
+
+    @Test
+    fun `an expired leaf that is the anchor is not trusted`() = runTest {
+        val expired = expiredCertificate()
+        val validation = validate(listOf(expired), listOf(expired))
+        assertIs<CertificationChainValidation.NotTrusted>(validation)
+        assertIs<CertificateExpiredException>(validation.cause)
+    }
+
+    @Test
+    fun `a chain whose leaf is not an anchor is validated as before`() = runTest {
+        assertIs<CertificationChainValidation.Trusted<TrustAnchor>>(
+            validate(listOf(certs.end, certs.intermediate), listOf(certs.root)),
+        )
+        assertIs<CertificationChainValidation.NotTrusted>(validate(listOf(certs.end), listOf(certs.root)))
+    }
+
+    private fun expiredCertificate(): X509Certificate {
+        val kp = KeyPairGenerator.getInstance("EC").apply { initialize(256) }.genKeyPair()
+        val day = 24L * 60 * 60 * 1000
+        val now = System.currentTimeMillis()
+        val name = X500Name("CN=Expired signer")
+        val holder = JcaX509v3CertificateBuilder(name, BigInteger.ONE, Date(now - 2 * day), Date(now - day), name, kp.public)
+            .build(JcaContentSignerBuilder("SHA256withECDSA").build(kp.private))
+        return JcaX509CertificateConverter().getCertificate(holder)
+    }
+}
