+package eu.europa.ec.eudi.wallet.registration
+
+import eu.europa.ec.eudi.statium.VerifyStatusListTokenCwtSignature
+import org.multipaz.cbor.Bstr
+import org.multipaz.cbor.Cbor
+import org.multipaz.cbor.CborArray
+import org.multipaz.cbor.Tagged
+import org.multipaz.cbor.Tstr
+import org.multipaz.cose.Cose
+import org.multipaz.cose.toCoseLabel
+import org.multipaz.crypto.Algorithm
+import org.multipaz.crypto.Crypto
+import org.multipaz.crypto.EcSignature
+import org.multipaz.crypto.javaX509Certificates
+import kotlin.time.Instant
+
+/**
+ * EDTP WD-16. Verifies a registration certificate's Status List Token served as a CWT: the COSE_Sign1
+ * signature with the leaf of its x5chain, then that chain against the registration-certificate status
+ * trust, as [RegistrationStatusTokenVerifier] does for a JWT. The Token Status List draft defines both
+ * formats and does not tie the Status List Token's format to the referenced token's; RFC 9360 lets
+ * x5chain sit in the protected or the unprotected header, so both are read, protected first; and RFC
+ * 9052 allows the COSE_Sign1 to be tagged or untagged, so both are read.
+ */
+internal class EdtpRegistrationStatusTokenCwtVerifier(
+    private val statusTrust: CertificateTrust? = null,
+) : VerifyStatusListTokenCwtSignature {
+
+    override suspend fun invoke(statusListToken: ByteArray, at: Instant): Result<Unit> = runCatching {
+        // A COSE_Sign1 may come tagged (COSE_Sign1_Tagged, tag 18, RFC 9052); the CBOR library reads
+        // only the untagged structure, so the tag is removed first.
+        val decoded = Cbor.decode(statusListToken)
+        val structure = if (decoded is Tagged && decoded.tagNumber == COSE_SIGN1_TAG) decoded.taggedItem else decoded
+        val coseSign1 = structure.asCoseSign1
+        val label = Cose.COSE_LABEL_X5CHAIN.toCoseLabel
+        val x5chain = (coseSign1.protectedHeaders[label] ?: coseSign1.unprotectedHeaders[label])
+            ?.asX509CertChain
+            ?: error("status list token has no x5chain")
+        val leaf = x5chain.certificates.firstOrNull() ?: error("status list token x5chain is empty")
+        val algorithm = coseSign1.protectedHeaders[Cose.COSE_LABEL_ALG.toCoseLabel]
+            ?.asNumber?.toInt()
+            ?.let { Algorithm.fromCoseAlgorithmIdentifier(it) }
+            ?: error("status list token has no alg in its protected header")
+        // The signature is checked over the protected header exactly as received (RFC 9052 §4.4). The
+        // library's own check re-encodes it, which breaks a valid signature whenever the signer encoded
+        // it differently — an indefinite-length map, for one.
+        val protectedBytes = ((structure as CborArray).items[0] as Bstr).value
+        val payload = coseSign1.payload ?: error("status list token has a detached payload")
+        val toBeSigned = Cbor.encode(
+            CborArray(mutableListOf(Tstr("Signature1"), Bstr(protectedBytes), Bstr(ByteArray(0)), Bstr(payload))),
+        )
+        Crypto.checkSignature(leaf.ecPublicKey, toBeSigned, algorithm, EcSignature.fromCoseEncoded(coseSign1.signature))
+        if (statusTrust != null) {
+            check(statusTrust.isTrusted(x5chain.javaX509Certificates)) {
+                "status list token certificate chain is not trusted"
+            }
+        }
+    }
+}
+
+private const val COSE_SIGN1_TAG = 18L
