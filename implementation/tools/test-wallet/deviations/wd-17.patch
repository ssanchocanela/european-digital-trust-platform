+package eu.europa.ec.eudi.wallet.registration.edtp
+
+import com.sun.net.httpserver.HttpServer
+import eu.europa.ec.eudi.statium.StatusIndex
+import eu.europa.ec.eudi.statium.StatusReference
+import eu.europa.ec.eudi.wallet.logging.Logger
+import eu.europa.ec.eudi.wallet.registration.RevocationOutcome
+import eu.europa.ec.eudi.wallet.registration.checkStatusListRevocation
+import eu.europa.ec.eudi.wallet.registration.edtpDecodeBase64UrlCwt
+import io.ktor.client.HttpClient
+import kotlinx.coroutines.runBlocking
+import org.junit.Assert.assertArrayEquals
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertSame
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.net.InetSocketAddress
+import java.util.Base64
+
+// EDTP WD-17 (a relaxation): a CWT Status List Token sent base64url-encoded as text is decoded to the
+// binary the specification requires, and nothing else is.
+class EdtpWd17Test {
+    private val text = FNMT_STATUS_LIST_CWT.toByteArray(Charsets.US_ASCII)
+    private val binary = Base64.getUrlDecoder().decode(FNMT_STATUS_LIST_CWT)
+
+    @Test
+    fun `base64url text of a COSE_Sign1 is decoded`() {
+        assertArrayEquals(binary, edtpDecodeBase64UrlCwt(text))
+    }
+
+    @Test
+    fun `a binary token is passed through untouched`() {
+        assertSame(binary, edtpDecodeBase64UrlCwt(binary))
+    }
+
+    @Test
+    fun `base64url text of anything else is left alone`() {
+        val other = Base64.getUrlEncoder().withoutPadding().encodeToString("not a cose structure".toByteArray()).toByteArray()
+        assertSame(other, edtpDecodeBase64UrlCwt(other))
+        val prose = "this is not base64url!".toByteArray()
+        assertSame(prose, edtpDecodeBase64UrlCwt(prose))
+    }
+
+    @Test
+    fun `the status check decodes such a body and goes on to validate the token`() = runBlocking {
+        val server = HttpServer.create(InetSocketAddress("127.0.0.1", 0), 0)
+        server.createContext("/sl") { ex ->
+            if ((ex.requestHeaders.getFirst("Accept") ?: "").contains("jwt")) {
+                ex.sendResponseHeaders(400, -1)
+            } else {
+                ex.responseHeaders.add("Content-Type", "application/statuslist+cwt")
+                ex.sendResponseHeaders(200, text.size.toLong()); ex.responseBody.write(text)
+            }
+            ex.close()
+        }
+        server.start()
+        try {
+            val messages = mutableListOf<String>()
+            val outcome = checkStatusListRevocation(
+                StatusReference(index = StatusIndex(15026), uri = "http://127.0.0.1:${server.address.port}/sl"),
+                null, Logger { messages += it.message }, { HttpClient() },
+            )
+            // The token names FNMT-RCM's address as its subject, not this local one, so it is refused —
+            // but only after it was decoded, its signature verified and its claims read.
+            assertEquals(RevocationOutcome.UNKNOWN, outcome)
+            assertTrue(messages.joinToString(), messages.any { "EDTP WD-17" in it })
+            assertTrue(messages.joinToString(), messages.any { "Wrong `sub`" in it })
+        } finally {
+            server.stop(0)
+        }
+    }
+
+    private companion object {
+        const val FNMT_STATUS_LIST_CWT = "0oRZA6O_ATgiEHgaYXBwbGljYXRpb24vc3RhdHVzbGlzdCtjd3QYIVkDfDCCA3gwggL_-ZkW3TH_mZa6Dkj3wsPEeIvoVzxWJCvLVl97oOMlkxZuGFsJUgkkSOaFiTBkv7StZJTxg9d-TBuVtnw5fLVl4PVQTZw-Ho-PxAYuYzJKi5WCSKvOu_URVB6OCAXEwggFtMBIGA1UdEwEB_-xcFjbBfgE1UChgfZV3L_5haV1QoKT6PxJ6BuL2zpm2MG5iRj8M4qpyg1l4fwvkAjBC_fFj2_o-82EQzDelY6krtXz58xsZkuYN3gfwCAWKtS_MO57o_iDqkNWVqUdASCr_v_9YuL8CeHpodHRwczovL3dycHJjLmRldi5jcmVkZW5jaWFsZXMuZm5tdC5lcy90b2tlbi1zdGF0dXMtbGlzdC9jcmVkZW50aWFsL3N0YXR1cy9zdGF0dXMtbGlzdC1pZC81NDBkY2UyM2Q2MzMzNmMxNzRiNTViMGQ0MmFlYzZlYQYaat9agAQabMCOABn__b9kYml0cwFjbHN0WBx4nO3BMQEAAADCoPVPbQo_oAAAAACAtwETiAAB__9YYEEiaP-uVKpcTx7HF4eM70cWtvq1u7DvQAzEPOiHP1V3pXKRN5RylmE-2rfkaO7uyhmWZY2L3jsoE8MTxFCsbmJ2sjRQXTi7PhpLNCZv_cTeq0QmuIh2NZBGlGXxCBrkmA"
+    }
