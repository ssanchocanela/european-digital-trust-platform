# Pinned upstream for the EDTP test wallet. Every value here is part of a test run's record.
#
# Sourced by build.sh. Changing any line invalidates previously recorded test results, because
# the wallet build is one of the things a result is a statement about.

# The official EUDI Reference Implementation Android wallet.
WALLET_UPSTREAM_URL="https://github.com/eu-digital-identity-wallet/eudi-app-android-wallet-ui.git"
WALLET_UPSTREAM_TAG="Wallet/Demo_Version=2026.09.42-Demo_Build=42"
WALLET_UPSTREAM_COMMIT="43f362d2a720edb6d37a356b6a51b52b32c61f25"

# Declared by the upstream build at that tag, recorded here so a prerequisite mismatch is
# caught by build.sh rather than by a confusing Gradle error.
WALLET_JDK_MAJOR="17"
WALLET_COMPILE_SDK="37"
WALLET_BUILD_TOOLS="37.0.0"

# Resolved from upstream's gradle/libs.versions.toml at that tag. Informational: Gradle
# resolves these itself. Listed so a run record can name them without reading the clone.
WALLET_CORE_VERSION="0.30.2"
WALLET_ETSI_LIB_VERSION="0.4.0-alpha.1"
WALLET_GRADLE_VERSION="9.7.1"
WALLET_AGP_VERSION="9.4.0"
WALLET_KOTLIN_VERSION="2.4.0"

# Our flavour. The name is load-bearing: it is the Gradle flavour, the applicationId suffix
# and the source-set directory name.
EDTP_FLAVOR="edtptest"
EDTP_APPLICATION_ID_SUFFIX=".edtptest"
EDTP_APP_NAME="EDTP Test Wallet — modified reference build"

# Stamped into the APK's versionName so a device screen identifies the build.
EDTP_VERSION_NAME="2026.09.42-edtptest"
