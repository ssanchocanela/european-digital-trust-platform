# European Digital Trust Platform V0 — local environment template.
#
#   cp .env.example .env
#   # fill in every value marked CHANGE-ME, then:
#   docker compose up
#
# This file is the only environment file committed. `.env` is ignored.
# Generate each secret with:  openssl rand -base64 32

# --- platform database ------------------------------------------------------------------
PLATFORM_DB_USER=edtp
PLATFORM_DB_PASSWORD=CHANGE-ME-platform-db-password
PLATFORM_DB_NAME=edtp_platform

# --- engine database (separate from the platform's, deliberately: ADR 0001, ADR 0004) ----
ENGINE_DB_USER=eudiplo
ENGINE_DB_PASSWORD=CHANGE-ME-engine-db-password
ENGINE_DB_NAME=eudiplo

# --- platform API -----------------------------------------------------------------------
LOG_LEVEL=info

# Bootstrap administrative key. Creates the first tenant and nothing else: it is refused on
# every tenant-scoped route, so it cannot act as a tenant. Minimum 32 characters.
PLATFORM_ADMIN_API_KEY=CHANGE-ME-at-least-32-characters-long-admin-key

# Public origin of this API. Used to build the same-device wallet return URL, so it must be
# reachable by the browser that starts the flow.
PLATFORM_PUBLIC_URL=http://localhost:3100

# --- wrapped engine ---------------------------------------------------------------------
# Drives every wallet-facing URL the engine emits. For a test with a physical phone this
# MUST be the public HTTPS origin of your tunnel or test host — a wallet cannot reach
# localhost, and the Reference Implementation refuses a self-signed TLS certificate.
# See docs/reference-wallet-testing.md.
ENGINE_PUBLIC_URL=http://localhost:3000
ENGINE_MASTER_SECRET=CHANGE-ME-at-least-32-characters-engine-master-secret
ENGINE_CLIENT_ID=root
ENGINE_CLIENT_SECRET=CHANGE-ME-engine-client-secret
ENGINE_LOG_LEVEL=warn

# Engine credentials per Relying Party Instance, as
#   engineTenantRef=clientId:clientSecret
# separated by commas. One entry per instance: the engine scopes every call to the tenant of
# the presenting token, and the platform maps one engine tenant to one Relying Party Instance
# (ADR 0002 Decision 3). The bootstrap entry below uses the engine's root client; create a
# per-tenant engine client before using more than one instance.
ENGINE_TENANT_CREDENTIALS=root=root:CHANGE-ME-engine-client-secret
