+package eu.europa.ec.eudi.wallet.registration.edtp
+
+import eu.europa.ec.eudi.wallet.registration.CertificateTrust
+import eu.europa.ec.eudi.wallet.registration.EdtpRegistrationStatusTokenCwtVerifier
+import kotlinx.coroutines.test.runTest
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.util.Base64
+import kotlin.time.Clock
+
+// EDTP WD-16: a registration certificate's Status List Token served as a CWT is verified — signature
+// with the leaf of its x5chain (here in the protected header), then that chain against the trust.
+class EdtpWd16Test {
+    // A real Status List Token, as FNMT-RCM's development WRPRC provider served it on 26 October 2026.
+    private val cwt: ByteArray = Base64.getUrlDecoder().decode(FNMT_STATUS_LIST_CWT)
+
+    @Test
+    fun `a CWT with x5chain in the protected header verifies`() = runTest {
+        assertTrue(EdtpRegistrationStatusTokenCwtVerifier(null)(cwt, Clock.System.now()).isSuccess)
+    }
+
+    @Test
+    fun `its chain is checked against the trust`() = runTest {
+        var seen = 0
+        val trusting = CertificateTrust { chain -> seen = chain.size; true }
+        assertTrue(EdtpRegistrationStatusTokenCwtVerifier(trusting)(cwt, Clock.System.now()).isSuccess)
+        assertTrue(seen > 0)
+        val refusing = CertificateTrust { false }
+        assertTrue(EdtpRegistrationStatusTokenCwtVerifier(refusing)(cwt, Clock.System.now()).isFailure)
+    }
+
+    @Test
+    fun `a tampered CWT is refused`() = runTest {
+        val tampered = cwt.copyOf().also { it[it.size - 10] = (it[it.size - 10].toInt() xor 0x01).toByte() }
+        assertTrue(EdtpRegistrationStatusTokenCwtVerifier(null)(tampered, Clock.System.now()).isFailure)
+    }
+
+    @Test
+    fun `bytes that are not a COSE_Sign1 are refused`() = runTest {
+        assertTrue(EdtpRegistrationStatusTokenCwtVerifier(null)("not a cwt".toByteArray(), Clock.System.now()).isFailure)
+    }
+
+    private companion object {
+        const val FNMT_STATUS_LIST_CWT = "0oRZA6O_ATgiEHgaYXBwbGljYXRpb24vc3RhdHVzbGlzdCtjd3QYIVkDfDCCA3gwggL_-ZkW3TH_mZa6Dkj3wsPEeIvoVzxWJCvLVl97oOMlkxZuGFsJUgkkSOaFiTBkv7StZJTxg9d-TBuVtnw5fLVl4PVQTZw-Ho-PxAYuYzJKi5WCSKvOu_URVB6OCAXEwggFtMBIGA1UdEwEB_-xcFjbBfgE1UChgfZV3L_5haV1QoKT6PxJ6BuL2zpm2MG5iRj8M4qpyg1l4fwvkAjBC_fFj2_o-82EQzDelY6krtXz58xsZkuYN3gfwCAWKtS_MO57o_iDqkNWVqUdASCr_v_9YuL8CeHpodHRwczovL3dycHJjLmRldi5jcmVkZW5jaWFsZXMuZm5tdC5lcy90b2tlbi1zdGF0dXMtbGlzdC9jcmVkZW50aWFsL3N0YXR1cy9zdGF0dXMtbGlzdC1pZC81NDBkY2UyM2Q2MzMzNmMxNzRiNTViMGQ0MmFlYzZlYQYaat9agAQabMCOABn__b9kYml0cwFjbHN0WBx4nO3BMQEAAADCoPVPbQo_oAAAAACAtwETiAAB__9YYEEiaP-uVKpcTx7HF4eM70cWtvq1u7DvQAzEPOiHP1V3pXKRN5RylmE-2rfkaO7uyhmWZY2L3jsoE8MTxFCsbmJ2sjRQXTi7PhpLNCZv_cTeq0QmuIh2NZBGlGXxCBrkmA"
