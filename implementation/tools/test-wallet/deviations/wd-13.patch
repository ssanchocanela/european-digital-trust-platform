         private fun Throwable.notTrusted(): CertificationChainValidation.NotTrusted =
             CertificationChainValidation.NotTrusted(this)
+
+        /**
+         * EDTP WD-13. A trust list may anchor a CA that is not a root, and an issuer may send a chain
+         * that continues above it. PKIX takes the anchor as an input, not as part of the path, and the
+         * JDK's validator refuses a path that runs past it. So the path is cut just below the first
+         * certificate, after the leaf, that is byte for byte one of the trust anchors' certificates;
+         * everything from the leaf up to it is validated as before. A name or key-identifier match is
+         * not enough, and a chain with no such certificate is validated unchanged.
+         */
+        internal fun List<X509Certificate>.upToTrustAnchor(trustAnchors: List<TrustAnchor>): List<X509Certificate> {
+            val anchors = trustAnchors.mapNotNull { it.trustedCert?.encoded }
+            val index = drop(1).indexOfFirst { cert -> anchors.any { it.contentEquals(cert.encoded) } }
+            return if (index < 0) this else subList(0, index + 1)
+        }
     }
