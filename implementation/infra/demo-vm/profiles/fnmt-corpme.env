# Client profile for an FNMT / CORPME demonstration (ADR 0010 §2). Switched on only with the
# organisations' written permission, for one demonstration; it reverts to `generic` after 4 hours.
#
# The branded pages are served only on edtp-cliente.murcata.es, behind Cloudflare Access: the form
# shows the neutral brand on any other host. The issuer names and emblems are in the engine's public
# metadata while this is on, because the wallet reads them without logging in — the stated residual
# risk.
ENGINE_ISSUER_DISPLAY_NAMES="pid-1=FNMT-RCM (demo);rpi-1=CORPME (demo)"
ENGINE_ISSUER_BRANDING=pid-1=https://edtp-pid.murcata.es/assets/fnmt-emblem.png,rpi-1=https://edtp-pid.murcata.es/assets/corpme-emblem.png
HOSTED_FORM_BRANDS="pid-1=fnmt;rpi-1=corpme"
HOSTED_FORM_PUBLIC_URL=https://edtp-cliente.murcata.es
