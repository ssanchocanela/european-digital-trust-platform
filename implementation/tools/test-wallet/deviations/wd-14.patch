+
+/**
+ * EDTP WD-14. ETSI TS 119 475 V1.2.1, Annex B.2.1, defines `srvDescription` as `[1..*]` "Array of
+ * MultiLangString objects" — an array of arrays, one per service, each holding the localised texts —
+ * and Annex C's example has that shape. This model takes a flat array, so a certificate written to the
+ * specification was refused whole as malformed. Both shapes are read; the services' texts are kept in
+ * order, flattened, which is what [RegistrationCertificate.serviceDescription] holds. Anything else in
+ * the array is refused, as before.
+ */
+internal object EdtpServiceDescriptionSerializer : KSerializer<List<MultiLangDto>> {
+    private val flat = ListSerializer(MultiLangDto.serializer())
+    override val descriptor: SerialDescriptor = flat.descriptor
+
+    override fun deserialize(decoder: Decoder): List<MultiLangDto> {
+        val json = decoder as? JsonDecoder ?: return flat.deserialize(decoder)
+        val element = json.decodeJsonElement() as? JsonArray
+            ?: throw SerializationException("srv_description is not an array")
+        return element.flatMap { item ->
+            when (item) {
+                is JsonObject -> listOf(json.json.decodeFromJsonElement(MultiLangDto.serializer(), item))
+                is JsonArray -> item.map { inner ->
+                    if (inner !is JsonObject) throw SerializationException("srv_description holds a non-object")
+                    json.json.decodeFromJsonElement(MultiLangDto.serializer(), inner)
+                }
+                else -> throw SerializationException("srv_description holds neither an object nor an array")
+            }
+        }
+    }
+
+    override fun serialize(encoder: Encoder, value: List<MultiLangDto>) = flat.serialize(encoder, value)
+}
