# Client profile for a Gobierno de Canarias demonstration of the Large Family Title (ADR 0010 §2).
# Switched on only with the organisation's written permission, for one demonstration; it reverts to
# `generic` after 4 hours.
#
# Only the Large Family Title's issuer, fam-1, takes the client's name and look; the PID issuer and the
# register keep their generic names. The branded form is served only on edtp-cliente.murcata.es, behind
# Cloudflare Access: any other host shows the neutral brand. The issuer name is in the engine's public
# metadata while this is on, because the wallet reads it without logging in — the stated residual risk.
# No emblem: the coat of arms is an official symbol and is not used without the organisation's say-so.
ENGINE_ISSUER_DISPLAY_NAMES="pid-1=PID Demo Issuer;rpi-1=Registro Demo;fam-1=Gobierno de Canarias (demo)"
ENGINE_ISSUER_BRANDING=
HOSTED_FORM_BRANDS="pid-1=demo;rpi-1=demo;fam-1=gobcan"
HOSTED_FORM_PUBLIC_URL=https://edtp-cliente.murcata.es
