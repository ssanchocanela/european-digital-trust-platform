+ * Licensed under the EUPL, Version 1.2 or - as soon they will be approved by the European
+ * Commission - subsequent versions of the EUPL (the "Licence"); You may not use this work
+ * except in compliance with the Licence. See https://joinup.ec.europa.eu/software/page/eupl
+ *
+ * ---
+ *
+ * EDTP addition. Not part of upstream Wallet Core. A process-wide switch the app sets from its
+ * granular-trust configuration: when any trust layer is in ENFORCE, the credential trust verifiers
+ * must NOT swallow a verification error (upstream returns null = fail-open). Wallet Core cannot see
+ * the app's TrustConfigHolder, so the app mirrors the decision here.
+ */
+package eu.europa.ec.eudi.wallet.trust
+
+object EdtpTrustEnforce {
+    @Volatile
+    @JvmStatic
+    var failClosed: Boolean = false
+}
diff --git a/wallet-core/src/main/java/eu/europa/ec/eudi/wallet/trust/MsoMdocCredentialTrustVerifier.kt b/wallet-core/src/main/java/eu/europa/ec/eudi/wallet/trust/MsoMdocCredentialTrustVerifier.kt
