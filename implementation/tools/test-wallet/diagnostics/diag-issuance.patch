+
+// EDTP DIAGNOSTIC (diag-issuance). Logging only; no behaviour changes. The issuance paths reduce a
+// failure to the generic "Something went wrong issuing your document(s)" and keep nothing else, and
+// upstream reports them at DEBUG at most — which WD-7 drops in a release build. Printed at ERROR
+// through android.util.Log, so it survives WD-7: type, message and toString (a sealed
+// CredentialIssuanceError carries its detail in fields), top frames, along the cause chain. Never a
+// request or response body.
+private fun edtpDiagLog(label: String, cause: Throwable?) {
+    var t: Throwable? = cause
+    var depth = 0
+    if (t == null) android.util.Log.e("EDTP-DIAG", "$label: <no throwable>")
+    while (t != null && depth < 10) {
+        android.util.Log.e(
+            "EDTP-DIAG",
+            "$label [$depth] ${t::class.qualifiedName}: ${t.message ?: "<no message>"} | $t"
+        )
+        t.stackTrace.take(4).forEach { f -> android.util.Log.e("EDTP-DIAG", "    at $f") }
+        t = t.cause
+        depth += 1
+    }
+}
