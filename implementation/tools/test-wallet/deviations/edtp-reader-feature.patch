+ * You may obtain a copy of the Licence at:
+ * https://joinup.ec.europa.eu/software/page/eupl
+ *
+ * Unless required by applicable law or agreed to in writing, software distributed under
+ * the Licence is distributed on an "AS IS" basis, WITHOUT WARRANTIES OR CONDITIONS OF
+ * ANY KIND, either express or implied. See the Licence for the specific language
+ * governing permissions and limitations under the Licence.
+ *
+ * ---
+ *
+ * EDTP addition. Not part of the upstream EUDI Reference Implementation. Compiled in only when the
+ * build is produced with `tools/test-wallet/build.sh --reader`; the deviation that adds this module
+ * (and registers it in settings.gradle.kts, the module enum, Koin and the navigation graph) is
+ * applied only under that flag, so without it the build is byte-for-byte upstream.
+ */
+
+import com.android.build.api.dsl.LibraryExtension
+import project.convention.logic.config.LibraryModule
+
+plugins {
+    id("project.android.feature")
+    // The proximity READER (verifier) role drives Multipaz directly (VerificationHelper, the BLE
+    // reader transports, DeviceRequestGenerator / DeviceResponseParser). This convention plugin adds
+    // `api(eudi-wallet-core)`, which brings Multipaz onto the compile classpath — the same source the
+    // holder role already uses. No new dependency is introduced; the version is the one pinned there.
+    id("project.wallet.core")
+}
+
+extensions.configure<LibraryExtension>("android") {
+    namespace = "eu.europa.ec.readerfeature"
+}
+
+moduleConfig {
+    module = LibraryModule.ReaderFeature
+}
+
+dependencies {
+    // Multipaz android-legacy carries the reader-side transport (VerificationHelper, the BLE reader
+    // transports). eudi-wallet-core exposes the Multipaz *core* (org.multipaz.*) but not this
+    // android-legacy module, so it is declared here. The version must track the Multipaz that
+    // eudi-wallet-core resolves (0.99.0 at the pinned wallet-core); if that bumps, bump this with it.
+    implementation("org.multipaz:multipaz-android-legacy:0.99.0")
+
+    // CameraX, to scan the holder's device-engagement QR. The decode itself reuses common-feature's
+    // QrCodeAnalyzer (ZXing lives there); these are the camera surface and lifecycle binding, which
+    // common-feature declares `implementation` and so does not expose.
+    implementation(libs.androidx.camera.core)
+    implementation(libs.androidx.camera.lifecycle)
+    implementation(libs.androidx.camera.view)
+    implementation(libs.androidx.camera.camera2)
+    // Runtime permission requests for BLE and the camera, on the scan screen.
+    implementation(libs.accompanist.permissions)
+}
