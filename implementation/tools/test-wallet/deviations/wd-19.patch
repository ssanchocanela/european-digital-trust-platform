@@ -0,0 +1,33 @@
+/*
+ * EDTP deviation WD-19. Not upstream.
+ */
+
+package eu.europa.ec.networklogic.di
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNull
+import org.junit.Test
+
+class EdtpRequestObjectAcceptTest {
+
+    private val requestObject = "application/oauth-authz-req+jwt"
+
+    @Test
+    fun `a request for a Request Object asks for nothing else`() {
+        assertEquals(requestObject, requestObjectAccept(listOf(requestObject, "application/jwt", "application/json")))
+        assertEquals(requestObject, requestObjectAccept(listOf("$requestObject; application/jwt; application/json")))
+        assertEquals(requestObject, requestObjectAccept(listOf("$requestObject, */*")))
+    }
+
+    @Test
+    fun `a request that already asks for it alone is left as it is`() {
+        assertNull(requestObjectAccept(listOf(requestObject)))
+    }
+
+    @Test
+    fun `any other request is left as it is`() {
+        assertNull(requestObjectAccept(listOf("application/jwt", "application/json")))
+        assertNull(requestObjectAccept(listOf("application/json")))
+        assertNull(requestObjectAccept(emptyList()))
+    }
+}
